      { scaleY: 0, transformOrigin: "top center", duration: 0.3, ease: "back.out(1.7)", overwrite: "auto" },
      earlyT
    );

    tl.from(
      "#beat9-early-label",
      { y: 16, opacity: 0, duration: 0.28, ease: "power3.out", overwrite: "auto" },
      earlyT + 0.1
    );

    // early exponential curve draws upward via stroke-dashoffset
    tl.to("#beat9-early-curve",
      {
        opacity: 1,
        strokeDashoffset: 0,
        duration: 0.5,
        ease: "power2.out",
        overwrite: "auto"
      },
      earlyT + 0.12
    );

    // ── Headline slams in on "earlier you" ────────────────────────────
    tl.to("#beat9-headline",
      {
        opacity: 1,
        y: 0,
        duration: 0.38,
        ease: "expo.out",
        overwrite: "auto"
      },
      earlyT + 0.05
    );

    // ── LATER peg + curve — appear on "you start," (smaller, dimmer) ──
    const laterT = landOn("you start,", 0);

    tl.to(
      ["#beat9-later-peg", "#beat9-later-label"],
      {
        opacity: 1,
        duration: 0.22,
        ease: "power2.out",
        stagger: 0.07,
        overwrite: "auto"
      },
      laterT
    );

    tl.from(
      "#beat9-later-peg",
      { scaleY: 0, transformOrigin: "top center", duration: 0.22, ease: "power2.out", overwrite: "auto" },
      laterT
    );

    tl.from(
      "#beat9-later-label",
      { y: 12, opacity: 0, duration: 0.2, ease: "power2.out", overwrite: "auto" },
      laterT + 0.08
    );

    tl.to("#beat9-later-curve",
      {
        opacity: 1,
        strokeDashoffset: 0,
        duration: 0.32,
        ease: "power1.out",
        overwrite: "auto"
      },
      laterT + 0.08
    );

    // ── Subline slides in on "the more" ───────────────────────────────
    tl.to("#beat9-subline",
      {
        opacity: 1,
        x: 0,
        duration: 0.42,
        ease: "expo.out",
        overwrite: "auto"
      },
      landOn("the more", 0.2)
    );

    // ── Idle: green growth curve gentle scale yoyo ────────────────────
    // fires after the early curve finishes drawing (earlyT + 0.62)
    const idleStart = earlyT + 0.65;
    tl.to("#beat9-early-curve",
      {
        scaleY: 1.02,
        transformOrigin: "bottom left",
        duration: 1.5,
        ease: "sine.inOut",
        yoyo: true,
        repeat: 1,
        overwrite: "auto"
      },
      idleStart
    );

    // ── Reaction: green curve flashes / scale-pulses on "in your favor." ─
    const favorT = landOn("in your favor.", 0);

    tl.to("#beat9-early-curve",
      {
        scaleY: 1.08,
        scaleX: 1.04,
        transformOrigin: "bottom left",
        stroke: "#FFFFFF",
        duration: 0.18,
