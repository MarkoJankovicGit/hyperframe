    const tickerItems = [];
    for (let i = 0; i < NUM_TICKERS; i++) {
      tickerItems.push({
        x: Math.round(rand() * 1080),
        y: Math.round(rand() * 2100),
        size: Math.round(24 + rand() * 22),
        speed: Math.round((8 + rand() * 14) * 100) / 100
      });
