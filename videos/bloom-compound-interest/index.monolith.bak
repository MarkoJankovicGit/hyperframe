    /* ── CALENDAR STRIP ──────────────────────────────────── */
    #beat10-calendar {
      position: absolute;
      top: 820px;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 18px;
    }

    .beat10-day-cell {
      width: 140px;
      height: 140px;
      border: 3px solid #C8CBD0;
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: #F5F6F7;
      opacity: 0;
