      font-size: 22px;
      color: #9CA3AF;
      margin-top: 6px;
    }

    /* ── STAT CALLOUT ────────────────────────────────────── */
    #beat10-stat-wrap {
      position: absolute;
      top: 1040px;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    #beat10-stat {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 180px;
      color: #1C2329;
      letter-spacing: -0.03em;
      line-height: 1;
      opacity: 0;
      position: relative;
      display: inline-block;
    }

    /* SVG strikethrough overlay */
    #beat10-strikethrough-svg {
      position: absolute;
      top: 50%;
      left: -20px;
      right: -20px;
      width: calc(100% + 40px);
      height: 28px;
      transform: translateY(-50%);
      overflow: visible;
      pointer-events: none;
    }

    #beat10-strike-line {
      stroke: #D63B3B;
      stroke-width: 14;
      stroke-linecap: round;
      fill: none;
    }

    /* ── NOT EVEN CLOSE ──────────────────────────────────── */
    #beat10-not-close {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 700;
      font-style: italic;
      font-size: 56px;
      color: #4A4F54;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      opacity: 0;
      margin-top: 32px;
    }

/* ====== BEAT 11 (mega-slam) ====== */
#beat11 {
      position: absolute;
      inset: 0;
