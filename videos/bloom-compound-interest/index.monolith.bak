  <script>
    window.__timelines = window.__timelines || {};
    const masterTl = gsap.timeline({ paused: true });
    window.__timelines["bloom-compound-interest"] = masterTl;
    window.__masterTl = masterTl;

    // Master scene fades — show scene at its start, hide at end
    const beatBoundaries = [{"n":1,"s":0,"e":2.4},{"n":2,"s":2.4,"e":6.1},{"n":3,"s":6.1,"e":12},{"n":4,"s":12,"e":17.7},{"n":5,"s":17.7,"e":22.95},{"n":6,"s":22.95,"e":25.75},{"n":7,"s":25.75,"e":33.75},{"n":8,"s":33.75,"e":39.95},{"n":9,"s":39.95,"e":46.3},{"n":10,"s":46.3,"e":52.75},{"n":11,"s":52.75,"e":56.3},{"n":12,"s":56.3,"e":65},{"n":13,"s":65,"e":73.3}];
    for (let i = 0; i < beatBoundaries.length; i++) {
      const b = beatBoundaries[i];
      const sel = "#beat" + b.n;
      // Fade in
      if (b.n > 1) {
        masterTl.to(sel, { opacity: 1, duration: 0.18, ease: "power2.out" }, b.s);
      }
      // Fade out previous
      if (b.n > 1) {
        const prev = beatBoundaries[i - 1];
        masterTl.to("#beat" + prev.n, { opacity: 0, duration: 0.18, ease: "power2.in" }, b.s);
      }
    }
    // Final fade-out of last beat
    masterTl.to("#beat13", { opacity: 0, duration: 0.18, ease: "power2.in" }, 73.3 - 0.2);
  </script>

// ====== BEAT 1 (hook) start=0.00 dur=2.40 ======
(function(){
const W = [
      { word: "You",      t: 0.000, e: 0.159 },
      { word: "just",     t: 0.207, e: 0.399 },
      { word: "won",      t: 0.459, e: 0.639 },
      { word: "the",      t: 0.659, e: 0.719 },
      { word: "lottery.", t: 0.789, e: 1.639 }
    ];

    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found in transcript`);
      if (hits.length > 1) {
        const times = hits.map(i => W[i].t.toFixed(3) + "s").join(", ");
        throw new Error(`landOn: phrase "${phrase}" matches ${hits.length} occurrences at [${times}]. Use a longer phrase to disambiguate.`);
      }
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase) { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, duration) { return at(phrase) - (duration || 0); }
    function landAfter(phrase, duration) { return W[_findPhrase(phrase).endIdx].e - (duration || 0); }

    function mulberry32(seed) {
      return function() {
        let t = (seed += 0x6d2b79f5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    const tickerCanvas = document.getElementById("beat1-canvas");
    const tCtx = tickerCanvas.getContext("2d");
    tickerCanvas.width = 1080;
    tickerCanvas.height = 1920;

    const tRand = mulberry32(7331);
    const dollarItems = [];
    for (let i = 0; i < 28; i++) {
      dollarItems.push({
        x: tRand() * 1080,
        y: tRand() * 1920,
        size: 28 + Math.floor(tRand() * 24)
      });
    }

    function drawTicker(elapsed) {
      tCtx.clearRect(0, 0, 1080, 1920);
      tCtx.fillStyle = "rgba(255, 255, 255, 0.12)";
      tCtx.textAlign = "center";
      dollarItems.forEach(item => {
        tCtx.font = `bold ${item.size}px Inter`;
        const y = Math.round((item.y + elapsed * 20) % 2000);
        tCtx.fillText("$", item.x, y);
      });
    }

    const confettiCanvas = document.getElementById("beat1-confetti");
    const cCtx = confettiCanvas.getContext("2d");
    confettiCanvas.width = 1080;
    confettiCanvas.height = 1920;

    const cRand = mulberry32(9421);
    const COLORS = ["#FFD700", "#FFB300", "#00C853", "#FFEE58", "#76FF03", "#FFF176"];
    const particles = [];
    const PARTICLE_COUNT = 80;
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const angle = (cRand() * Math.PI * 2);
      const speed = 400 + cRand() * 600;
      particles.push({
        x: 540,
        y: 980,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed - 200,
        color: COLORS[Math.floor(cRand() * COLORS.length)],
        size: 8 + Math.floor(cRand() * 10),
        rotation: cRand() * Math.PI * 2,
        rotSpeed: (cRand() - 0.5) * 10
      });
    }

    function drawConfetti(elapsed) {
      cCtx.clearRect(0, 0, 1080, 1920);
      const gravity = 980;
      particles.forEach(p => {
        const t = elapsed;
        const cx = p.x + p.vx * t;
        const cy = p.y + p.vy * t + 0.5 * gravity * t * t;
        const rot = p.rotation + p.rotSpeed * t;
        const alpha = Math.max(0, 1 - t * 1.2);
        if (alpha <= 0) return;
        cCtx.save();
        cCtx.globalAlpha = alpha;
        cCtx.translate(Math.round(cx), Math.round(cy));
        cCtx.rotate(rot);
        cCtx.fillStyle = p.color;
        cCtx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
        cCtx.restore();
      });
    }

    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });

    const tickerProxy = { time: 0 };
    tl.to("#beat1-canvas", { opacity: 0.5, duration: 0.25, ease: "power2.out" }, 0);
    tl.to(tickerProxy, {
      time: 2.4,
      duration: 2.4,
      ease: "none",
      onUpdate: () => drawTicker(tickerProxy.time)
    }, 0);

    tl.from("#b1w-you", {
      y: 20,
      opacity: 0,
      duration: 0.22,
      ease: "power3.out",
      overwrite: "auto"
    }, landOn("You", 0.22));

    tl.from("#b1w-just", {
      y: 20,
      opacity: 0,
      duration: 0.22,
      ease: "expo.out",
      overwrite: "auto"
    }, landOn("just", 0.22));

    tl.from("#b1w-won", {
      scale: 0.6,
      opacity: 0,
      duration: 0.25,
      ease: "back.out(2)",
      overwrite: "auto"
    }, landOn("won", 0.25));

    tl.from(".b1-badge", {
      scale: 0.4,
      opacity: 0,
      duration: 0.32,
      ease: "back.out(2.2)",
      overwrite: "auto"
    }, landOn("lottery", 0.32));
    tl.to(".b1-badge", {
      opacity: 1,
      duration: 0,
      overwrite: "auto"
    }, landOn("lottery", 0.32));

    const confettiProxy = { time: 0 };
    tl.to(confettiProxy, {
      time: 1.5,
      duration: 1.5,
      ease: "none",
      onUpdate: () => drawConfetti(confettiProxy.time)
    }, at("lottery"));

    tl.set("#beat1", { visibility: "hidden" }, 2.40);

    window.__timelines["bloom-compound-interest-beat-1"] = tl;
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 0); tl.resume();
  }
})();

// ====== BEAT 2 (choice-a) start=2.40 dur=3.70 ======
(function(){
// ── TIMELINE REGISTRATION ────────────────────────────────────────────────
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    window.__timelines["bloom-compound-interest-beat-2"] = tl;

    // ── VO WORD TIMING (beat-relative; negative t words are pre-beat) ────────
    const W = [
      { word: "And",      t: -0.671, e: -0.401 },
      { word: "here's",   t: -0.353, e: -0.081 },
      { word: "your",     t: -0.049, e: 0.079 },
      { word: "choice:",  t: 0.136,  e: 1.198 },
      { word: "one",      t: 1.238,  e: 1.358 },
      { word: "million",  t: 1.408,  e: 1.758 },
      { word: "dollars",  t: 1.828,  e: 2.318 },
      { word: "right",    t: 2.398,  e: 2.798 },
      { word: "now",      t: 2.918,  e: 3.278 }
    ];

    // ── PHRASE-ANCHORED TIMING HELPERS ───────────────────────────────────────
    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found in transcript`);
      if (hits.length > 1) {
        const times = hits.map(i => W[i].t.toFixed(3) + "s").join(", ");
        throw new Error(`landOn: phrase "${phrase}" matches ${hits.length} occurrences at [${times}]. Use a longer phrase.`);
      }
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase)                  { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, duration)    { return at(phrase) - (duration || 0); }
    function landAfter(phrase, duration) { return W[_findPhrase(phrase).endIdx].e - (duration || 0); }

    // ── DOTTED GRID (deterministic) ──────────────────────────────────────────
    const gridCanvas = document.getElementById("beat2-grid");
    const gctx = gridCanvas.getContext("2d");
    gridCanvas.width  = 1080;
    gridCanvas.height = 1920;
    gctx.fillStyle = "rgba(22, 88, 255, 0.06)";
    const SPACING = 60;
    for (let cx = SPACING / 2; cx < 1080; cx += SPACING) {
      for (let cy = SPACING / 2; cy < 1920; cy += SPACING) {
        gctx.beginPath();
        gctx.arc(cx, cy, 3, 0, Math.PI * 2);
        gctx.fill();
      }
    }

    // ── COUNTER (number roll 0 → 1,000,000) ─────────────────────────────────
    const counterEl   = document.getElementById("b2-counter-display");
    const counterProxy = { val: 0 };

    function formatCounter(n) {
      const rounded = Math.round(n);
      if (rounded <= 0) return "$0";
      return "$" + rounded.toLocaleString("en-US");
    }

    // Counter entrance duration: from card entrance to landAfter("one million dollars")
    // Card entrance fires at landOn("one million", 0.45)
    // landAfter("one million dollars") = W["dollars"].e = 2.318
    // Card entrance start = landOn("one million", 0.45) = W["one"].t - 0.45 = 1.238 - 0.45 = 0.788
    // Counter ramp starts shortly after card arrives (~0.45s entrance duration) => ~0.788 + 0.45 = 1.238
    // Counter end = landAfter("one million dollars", 1.0) = W["dollars"].e - 1.0 = 2.318 - 1.0 = 1.318
    // That gives only 0.08s which is too short — use landAfter("one million dollars", 0) = 2.318
    // and start counting from card entrance + 0.45s
    const counterStart = landOn("one million", 0.45) + 0.45;  // ~1.238
    const counterEnd   = landAfter("one million dollars", 0);  // 2.318
    const counterDur   = counterEnd - counterStart;             // ~1.08s

    tl.to(counterProxy, {
      val: 1000000,
      duration: counterDur,
      ease: "power3.out",
      onUpdate: function() {
        counterEl.textContent = formatCounter(counterProxy.val);
      }
    }, counterStart);

    // ── EYEBROW ENTRANCE ─────────────────────────────────────────────────────
    // Clamp negative-t words: eyebrow enters at t=0.1 (composition start)
    tl.from(".b2-eyebrow", {
      y: -40,
      opacity: 0,
      duration: 0.55,
      ease: "expo.out"
    }, 0.1);

    // ── CARD ENTRANCE ────────────────────────────────────────────────────────
    // landOn("one million", 0.45): at("one million") - 0.45 = 1.238 - 0.45 = 0.788
    const cardEntranceTime = landOn("one million", 0.45);
    tl.from(".b2-card", {
      y: 80,
      opacity: 0,
      scale: 0.95,
      duration: 0.45,
      ease: "back.out(1.7)"
    }, cardEntranceTime);

    // ── COIN ENTRANCE ─────────────────────────────────────────────────────────
    tl.from("#b2-coin", {
      x: 60,
      opacity: 0,
      duration: 0.40,
      ease: "power2.out"
    }, cardEntranceTime + 0.15);

    // ── COIN IDLE BOB ─────────────────────────────────────────────────────────
    // Duration from coin visible to end: 3.90 - (cardEntranceTime + 0.15 + 0.40)
    // = 3.90 - 1.33 = 2.57s  → ~2 full yoyo cycles of 0.8s each (repeat: 3 gives 3.2s, cap at 2)
    tl.to("#b2-coin", {
      y: -8,
      duration: 0.8,
      ease: "sine.inOut",
      yoyo: true,
      repeat: 3,
      overwrite: "auto"
    }, cardEntranceTime + 0.55);

    // ── "RIGHT NOW" PULSE ─────────────────────────────────────────────────────
    // landOn("right now", 0.2) = W["right"].t - 0.2 = 2.398 - 0.2 = 2.198
    const rightNowTime = landOn("right now", 0.2);
    tl.to("#b2-rightnow", {
      scale: 1.06,
      duration: 0.18,
      ease: "power2.out",
      yoyo: true,
      repeat: 1,
      overwrite: "auto"
    }, rightNowTime);

    // ── VISIBILITY KILL ───────────────────────────────────────────────────────
    tl.set("#beat2", { visibility: "hidden" }, 3.90);
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 2.4); tl.resume();
  }
})();

// ====== BEAT 3 (choice-b) start=6.10 dur=5.90 ======
(function(){
// ── TIMELINE REGISTRATION ────────────────────────────────────────────
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    window.__timelines["bloom-compound-interest-beat-3"] = tl;

    // ── VO WORD TIMING (beat-relative) ───────────────────────────────────
    const W = [
      { word: "or",       t: 0.245, e: 0.459 },
      { word: "a",        t: 0.539, e: 0.619 },
      { word: "penny",    t: 0.699, e: 1.099 },
      { word: "that",     t: 1.179, e: 1.499 },
      { word: "doubles",  t: 1.559, e: 1.979 },
      { word: "every",    t: 2.046, e: 2.381 },
      { word: "single",   t: 2.438, e: 2.78  },
      { word: "day",      t: 2.86,  e: 3.1   },
      { word: "for",      t: 3.16,  e: 3.34  },
      { word: "thirty",   t: 3.386, e: 3.662 },
      { word: "days.",    t: 3.742, e: 4.222 },
      { word: "Which",    t: 4.369, e: 5.104 },
      { word: "would",    t: 5.131, e: 5.266 },
      { word: "you",      t: 5.286, e: 5.346 },
      { word: "take?",    t: 5.41,  e: 5.746 }
    ];

    // ── PHRASE-ANCHORED TIMING HELPERS ────────────────────────────────────
    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found`);
      if (hits.length > 1) throw new Error(`landOn: phrase "${phrase}" ambiguous`);
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase)            { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, dur)   { return at(phrase) - (dur || 0); }
    function landAfter(phrase, dur){ return W[_findPhrase(phrase).endIdx].e - (dur || 0); }

    // ── BUILD 30 PENNY DOTS ───────────────────────────────────────────────
    const dotsRow = document.getElementById("beat3-dots-row");
    for (let i = 0; i < 30; i++) {
      const d = document.createElement("div");
      d.className = "beat3-dot";
      d.id = "beat3-dot-" + i;
      dotsRow.appendChild(d);
    }

    // ── ANIMATION ────────────────────────────────────────────────────────

    // 1. Background grid fade-in
    tl.from("#beat3-grid", { opacity: 0, duration: 0.5, ease: "power2.out" }, 0.1);

    // 2. OPTION B badge slides down from above
    tl.from("#beat3-badge", {
      y: -80,
      opacity: 0,
      duration: 0.5,
      ease: "expo.out"
    }, 0.15);

    // 3. PENNY coin SLAMS in on "penny" — scale + spin + back bounce
    const pennyHit = landOn("penny", 0.45);
    tl.from("#beat3-coin-wrap", {
      scale: 0,
      rotation: -180,
      opacity: 0,
      duration: 0.45,
      ease: "back.out(1.7)"
    }, pennyHit);

    // Coin label fades in slightly after coin lands
    tl.from("#beat3-coin-label", {
      opacity: 0,
      scale: 0.6,
      duration: 0.25,
      ease: "power3.out"
    }, pennyHit + 0.25);

    // 4. Penny idle wobble: rotation yoyo (2 cycles, covering "doubles" through "thirty")
    const idleStart = at("doubles");
    tl.to("#beat3-coin-wrap", {
      rotation: 4,
      duration: 0.8,
      ease: "sine.inOut",
      yoyo: true,
      repeat: 3
    }, idleStart);

    // 5. Doubles label enters on "doubles"
    tl.from("#beat3-doubles-label", {
      y: 30,
      opacity: 0,
      duration: 0.4,
      ease: "power3.out"
    }, landOn("doubles", 0.4));

    // 6. Dots row container enters on "every"
    tl.from("#beat3-dots-row", {
      opacity: 0,
      y: 20,
      duration: 0.35,
      ease: "power2.out"
    }, landOn("every", 0.35));

    // 7. Dots light up as a wave — from "doubles" through "days."
    // Stagger 30 dots across the window from "doubles" → end of "days."
    const waveStart = at("doubles");
    const waveEnd   = W[_findPhrase("days.").endIdx].e;  // 4.222
    const waveDur   = waveEnd - waveStart;               // ~2.663s
    const staggerInterval = waveDur / 30;

    for (let i = 0; i < 30; i++) {
      const dotHit = waveStart + i * staggerInterval;
      tl.to("#beat3-dot-" + i, {
        backgroundColor: i < 15 ? "#C8A951" : "#2DB87A",
        scale: 1.35,
        duration: 0.22,
        ease: "back.out(2)"
      }, dotHit);
      tl.to("#beat3-dot-" + i, {
        scale: 1,
        duration: 0.18,
        ease: "power2.out"
      }, dotHit + 0.22);
    }

    // 8. "WHICH WOULD YOU TAKE?" headline slams in on "Which would you"
    const headlineHit = landOn("Which would you", 0.5);
    tl.from("#beat3-headline", {
      y: 120,
      opacity: 0,
      scale: 0.85,
      duration: 0.5,
      ease: "back.out(1.4)"
    }, headlineHit);

    // Headline pulse on "take?"
    const takePulse = at("take?");
    tl.to("#beat3-headline", {
      scale: 1.04,
      duration: 0.12,
      ease: "power2.out"
    }, takePulse);
    tl.to("#beat3-headline", {
      scale: 1,
      duration: 0.22,
      ease: "power2.inOut"
    }, takePulse + 0.12);

    // 9. Kill visibility at end
    tl.set("#beat3", { visibility: "hidden" }, 5.90);
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 6.1); tl.resume();
  }
})();

// ====== BEAT 4 (stat-a) start=12.00 dur=5.70 ======
(function(){
// ── TIMELINE REGISTRATION ────────────────────────────────────────────
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    window.__timelines["bloom-compound-interest-beat-4"] = tl;

    // ── VO WORD TIMING (beat-relative) ───────────────────────────────────
    const W = [
      { word: "After",    t: 0.033, e: 0.968 },
      { word: "thirty",   t: 1.025, e: 1.367 },
      { word: "days,",    t: 1.463, e: 2.007 },
      { word: "the",      t: 2.047, e: 2.167 },
      { word: "one",      t: 2.207, e: 2.327 },
      { word: "million",  t: 2.377, e: 2.727 },
      { word: "dollars",  t: 2.787, e: 3.207 },
      { word: "is",       t: 3.314, e: 3.528 },
      { word: "still",    t: 3.595, e: 3.93  },
      { word: "just",     t: 4.01,  e: 4.33  },
      { word: "one",      t: 4.39,  e: 4.57  },
      { word: "million",  t: 4.61,  e: 4.89  },
      { word: "dollars.", t: 4.95,  e: 5.53  }
    ];

    // ── PHRASE-ANCHORED TIMING HELPERS ────────────────────────────────────
    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found in transcript`);
      if (hits.length > 1) {
        const times = hits.map(i => W[i].t.toFixed(3) + "s").join(", ");
        throw new Error(`landOn: phrase "${phrase}" matches ${hits.length} occurrences at [${times}]. Use a longer phrase.`);
      }
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase) { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, duration) { return at(phrase) - (duration || 0); }
    function landAfter(phrase, duration) { return W[_findPhrase(phrase).endIdx].e - (duration || 0); }

    // ── COUNTER HELPER ────────────────────────────────────────────────────
    function formatCounter(val) {
      return "$" + Math.round(val).toLocaleString("en-US");
    }

    // ── ANIMATIONS ────────────────────────────────────────────────────────

    // 1. Eyebrow slides in from top — entrance on "After thirty"
    tl.from("#beat4-eyebrow", {
      y: -60,
      opacity: 0,
      duration: 0.55,
      ease: "power3.out"
    }, landOn("After thirty", 0.45));

    // 2. Counter: count up from 0 to 1,000,000
    //    Begins at "After" (t=0.033), lands by the time narrator says "dollars" ends (~3.207)
    const counterProxy = { val: 0 };
    const counterEl = document.getElementById("beat4-counter");
    const counterStart = at("After thirty") - 0.2;
    const counterEnd = landAfter("dollars", 0); // ~3.207

    tl.fromTo(counterProxy,
      { val: 0 },
      {
        val: 1000000,
        duration: counterEnd - counterStart,
        ease: "power2.out",
        onUpdate: () => {
          counterEl.textContent = formatCounter(counterProxy.val);
        },
        onComplete: () => {
          counterEl.textContent = "$1,000,000";
        }
      },
      counterStart
    );

    // Counter entrance: slide up
    tl.from("#beat4-counter", {
      y: 50,
      opacity: 0,
      duration: 0.5,
      ease: "expo.out"
    }, counterStart);

    // 3. Sparkline draws left-to-right after counter lands (~3.2s)
    const sparklineStart = counterEnd + 0.1;
    tl.fromTo("#beat4-sparkline-fill",
      { width: "0px" },
      { width: "600px", duration: 0.6, ease: "power2.out" },
      sparklineStart
    );

    // Sparkline track fades in just before fill draws
    tl.from("#beat4-sparkline-track", {
      opacity: 0,
      duration: 0.3,
      ease: "power1.out"
    }, sparklineStart - 0.1);

    // 4. "Flat" label fades in after sparkline
    tl.from("#beat4-flat-label", {
      opacity: 0,
      duration: 0.35,
      ease: "power1.out"
    }, sparklineStart + 0.5);

    // 5. Badge slams in on "still just"
    tl.fromTo("#beat4-badge",
      { scale: 1.3, opacity: 0, y: 24 },
      { scale: 1, opacity: 1, y: 0, duration: 0.3, ease: "back.out(2)" },
      landOn("still just", 0.1)
    );

    // 6. Counter pulse reaction on "just one million dollars."
    tl.to("#beat4-counter", {
      scale: 1.04,
      duration: 0.18,
      ease: "power2.out",
      yoyo: true,
      repeat: 1
    }, landOn("just one million dollars.", 0));

    // 7. Kill visibility at beat end
    tl.set("#beat4", { visibility: "hidden" }, 5.70);
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 12); tl.resume();
  }
})();

// ====== BEAT 5 (stat-b) start=17.70 dur=5.25 ======
(function(){
// ── TIMELINE REGISTRATION ─────────────────────────────────────────────
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    window.__timelines["bloom-compound-interest-beat-5"] = tl;

    // ── VO WORD TIMING (beat-relative) ───────────────────────────────────
    const W = [
      { word: "But",      t: 0.01,  e: 0.55 },
      { word: "the",      t: 0.57,  e: 0.63 },
      { word: "doubling", t: 0.674, e: 1.026 },
      { word: "penny?",   t: 1.093, e: 1.868 },
      { word: "It",       t: 2.015, e: 2.309 },
      { word: "becomes",  t: 2.379, e: 2.869 },
      { word: "five",     t: 2.949, e: 3.269 },
      { word: "point",    t: 3.362, e: 3.827 },
      { word: "three",    t: 3.867, e: 4.067 },
      { word: "million",  t: 4.127, e: 4.547 },
      { word: "dollars.", t: 4.607, e: 5.187 }
    ];

    // ── PHRASE-ANCHORED TIMING HELPERS ────────────────────────────────────
    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found`);
      if (hits.length > 1) {
        const times = hits.map(i => W[i].t.toFixed(3) + "s").join(", ");
        throw new Error(`landOn: "${phrase}" ambiguous at [${times}]`);
      }
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase) { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, duration) { return at(phrase) - (duration || 0); }
    function landAfter(phrase, duration) { return W[_findPhrase(phrase).endIdx].e + (duration || 0); }

    // ── DETERMINISTIC PRNG (mulberry32, seed=7) ───────────────────────────
    function mulberry32(seed) {
      return function () {
        let t = (seed += 0x6d2b79f5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // ── CURVE PATH SETUP ──────────────────────────────────────────────────
    // Points along the SVG path for penny animation (normalized 0-1)
    // The SVG viewBox is 0 0 1080 960; curve maps to 1920px canvas via transform
    // We'll sample the curve points manually matching the bezier
    function getCurvePoint(progress) {
      // Cubic bezier segments matching the path:
      // M80,940 C200,920 320,880 420,800 C520,720 580,600 660,460 C720,360 780,240 860,140 C920,70 970,42 1000,40
      // 4 segments, each 25% of progress
      const segments = [
        { p0:[80,940], p1:[200,920], p2:[320,880], p3:[420,800] },
        { p0:[420,800], p1:[520,720], p2:[580,600], p3:[660,460] },
        { p0:[660,460], p1:[720,360], p2:[780,240], p3:[860,140] },
        { p0:[860,140], p1:[920,70],  p2:[970,42],  p3:[1000,40] }
      ];
      const segIdx = Math.min(Math.floor(progress * 4), 3);
      const t = (progress * 4) - segIdx;
      const seg = segments[segIdx];
      const mt = 1 - t;
      const x = mt*mt*mt*seg.p0[0] + 3*mt*mt*t*seg.p1[0] + 3*mt*t*t*seg.p2[0] + t*t*t*seg.p3[0];
      const y = mt*mt*mt*seg.p0[1] + 3*mt*mt*t*seg.p1[1] + 3*mt*t*t*seg.p2[1] + t*t*t*seg.p3[1];
      // SVG viewBox 1080x960 maps to actual element 1080x960 positioned at bottom of 1920px canvas
      // beat5-curve-svg is bottom:0, so actual canvas Y = 960px offset from top
      return { x: x, y: y + 960 };
    }

    // ── SPARK TRAIL CANVAS ────────────────────────────────────────────────
    const sparkCanvas = document.getElementById("beat5-spark-canvas");
    const sparkCtx = sparkCanvas.getContext("2d");
    const sparkTrail = [];

    function drawSparks() {
      sparkCtx.clearRect(0, 0, 1080, 1920);
      for (let i = 0; i < sparkTrail.length; i++) {
        const s = sparkTrail[i];
        const alpha = s.life;
        sparkCtx.beginPath();
        sparkCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        sparkCtx.fillStyle = `rgba(1, 205, 116, ${alpha * 0.7})`;
        sparkCtx.fill();
      }
    }

    // ── STROKE DASHOFFSET ANIMATION + PENNY TRACKING ─────────────────────
    const curvePath = document.getElementById("beat5-curve-path");
    const pathLength = 1600; // approximate stroke length
    curvePath.style.strokeDasharray = pathLength;
    curvePath.style.strokeDashoffset = pathLength;

    const pennyDot = document.getElementById("beat5-penny-dot");
    const curveProxy = { progress: 0 };

    // Curve draws in from "It becomes" to "million dollars."
    const curveStart = landOn("It becomes", 0);
    const curveDuration = landAfter("million dollars.", 0) - curveStart;

    tl.to(curveProxy, {
      progress: 1,
      duration: curveDuration,
      ease: "power2.inOut",
      overwrite: "auto",
      onUpdate: function () {
        const p = curveProxy.progress;
        // Update stroke dashoffset
        curvePath.style.strokeDashoffset = pathLength * (1 - p);

        // Move penny along curve
        const pt = getCurvePoint(p);
        pennyDot.style.left = Math.round(pt.x) + "px";
        pennyDot.style.top = Math.round(pt.y) + "px";

        // Add spark trail point
        sparkTrail.push({ x: Math.round(pt.x), y: Math.round(pt.y), r: 6 + Math.round(p * 10), life: 0.9 });
        if (sparkTrail.length > 28) sparkTrail.shift();
        // Decay existing sparks
        for (let i = 0; i < sparkTrail.length - 1; i++) {
          sparkTrail[i].life = Math.max(0, sparkTrail[i].life - 0.04);
        }
        drawSparks();
      }
    }, curveStart);

    // ── PENNY DOT ENTRANCE ────────────────────────────────────────────────
    tl.from("#beat5-penny-dot", {
      scale: 0,
      opacity: 0,
      duration: 0.3,
      ease: "back.out(2)",
      overwrite: "auto"
    }, curveStart);

    // Position penny at curve start before animation
    tl.set("#beat5-penny-dot", {
      left: "80px",
      top: Math.round(960 + 940) + "px",
      opacity: 1
    }, curveStart - 0.01);

    // ── PENNY IDLE DRIFT (before curve draw) ─────────────────────────────
    // Before the curve draws, penny gently bobs at start position
    tl.to("#beat5-penny-dot", {
      y: -12,
      duration: 0.6,
      ease: "sine.inOut",
      yoyo: true,
      repeat: Math.ceil(curveStart / 1.2),
      overwrite: "auto"
    }, 0.3);

    // ── EYEBROW: slides in on "doubling penny" ────────────────────────────
    tl.from("#beat5-eyebrow", {
      x: -120,
      opacity: 0,
      duration: 0.45,
      ease: "expo.out",
      overwrite: "auto"
    }, landOn("doubling penny", 0.45));

    // Eyebrow idle gentle sway
    tl.to("#beat5-eyebrow", {
      y: -6,
      duration: 1.8,
      ease: "sine.inOut",
      yoyo: true,
      repeat: 2,
      overwrite: "auto"
    }, landOn("doubling penny", 0.45) + 0.5);

    // ── COUNTER: count from 0 → 5,368,709 on "million dollars." ─────────
    const FINAL_VALUE = 5368709;
    const counterEl = document.getElementById("beat5-counter");
    const counterProxy = { value: 0 };

    const counterLandTime = landAfter("million dollars.", 1.4);
    const counterStartTime = landOn("five point three", 0);
    const counterDuration = counterLandTime - counterStartTime;

    tl.from("#beat5-counter", {
      opacity: 0,
      y: 40,
      duration: 0.35,
      ease: "power3.out",
      overwrite: "auto"
    }, counterStartTime);

    tl.to(counterProxy, {
      value: FINAL_VALUE,
      duration: counterDuration,
      ease: "power3.out",
      overwrite: "auto",
      onUpdate: function () {
        const v = Math.round(counterProxy.value);
        counterEl.textContent = "$" + v.toLocaleString("en-US");
      },
      onComplete: function () {
        counterEl.textContent = "$5,368,709";
      }
    }, counterStartTime);

    // ── COUNTER POST-LAND REACTION: scale yoyo ───────────────────────────
    tl.to("#beat5-counter", {
      scale: 1.05,
      duration: 0.18,
      ease: "power2.out",
      yoyo: true,
      repeat: 1,
      overwrite: "auto"
    }, counterLandTime);

    // ── SUBTITLE: "AFTER 30 DAYS" fades in just after counter lands ──────
    tl.from("#beat5-subtitle", {
      opacity: 0,
      y: 20,
      duration: 0.3,
      ease: "power2.out",
      overwrite: "auto"
    }, counterLandTime + 0.05);

    // ── PARTICLE BURST on counter land ───────────────────────────────────
    const particleCanvas = document.getElementById("beat5-particle-canvas");
    const pCtx = particleCanvas.getContext("2d");
    const rand = mulberry32(7);

    // Pre-generate 80 deterministic particles
    const PARTICLE_COUNT = 80;
    const PARTICLE_COLORS = ["#FFFFFF", "#FFFFFF", "#EFC42C", "#EFC42C", "#01CD74"];
    const particles = [];
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const angle = rand() * Math.PI * 2;
      const speed = 180 + rand() * 340;
      const colorIdx = Math.floor(rand() * PARTICLE_COLORS.length);
      particles.push({
        angle,
        speed,
        color: PARTICLE_COLORS[colorIdx],
        size: Math.round(3 + rand() * 7),
        delay: rand() * 0.12
      });
    }

    // Counter approximate center position in px (counter is centered at ~540, ~960 + offset)
    // The counter sits centered in beat5 at flex center, roughly y=900 in 1920px layout
    const BURST_X = 540;
    const BURST_Y = 920;
    const BURST_DURATION = 1.4;

    const burstProxy = { t: 0 };
    tl.to(burstProxy, {
      t: BURST_DURATION,
      duration: BURST_DURATION,
      ease: "none",
      overwrite: "auto",
      onUpdate: function () {
        pCtx.clearRect(0, 0, 1080, 1920);
        const now = burstProxy.t;
        for (let i = 0; i < PARTICLE_COUNT; i++) {
          const p = particles[i];
          const elapsed = now - p.delay;
          if (elapsed <= 0) continue;
          const life = Math.max(0, 1 - elapsed / BURST_DURATION);
          if (life <= 0) continue;
          const dist = p.speed * elapsed * (1 - elapsed / BURST_DURATION);
          const px = Math.round(BURST_X + Math.cos(p.angle) * dist);
          const py = Math.round(BURST_Y + Math.sin(p.angle) * dist);
          pCtx.globalAlpha = life * 0.92;
          pCtx.fillStyle = p.color;
          pCtx.beginPath();
          pCtx.arc(px, py, p.size, 0, Math.PI * 2);
          pCtx.fill();
        }
        pCtx.globalAlpha = 1;
      },
      onComplete: function () {
        pCtx.clearRect(0, 0, 1080, 1920);
      }
    }, counterLandTime);

    // ── CURVE IDLE VERTICAL DRIFT (after draw completes) ─────────────────
    const curveEndTime = curveStart + curveDuration;
    tl.to("#beat5-curve-svg", {
      y: -14,
      duration: 1.6,
      ease: "sine.inOut",
      yoyo: true,
      repeat: Math.ceil((5.25 - curveEndTime) / 3.2),
      overwrite: "auto"
    }, curveEndTime + 0.1);

    // ── VISIBILITY KILL at 5.25s ──────────────────────────────────────────
    tl.set("#beat5", { visibility: "hidden" }, 5.25);
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 17.7); tl.resume();
  }
})();

// ====== BEAT 6 (concept-name) start=22.95 dur=2.80 ======
(function(){
const W = [
      { word: "This",      t: 0.161, e: 1.057 },
      { word: "is",        t: 1.137, e: 1.297 },
      { word: "compound",  t: 1.377, e: 2.017 },
      { word: "interest.", t: 2.079, e: 2.655 }
    ];

    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found in transcript`);
      if (hits.length > 1) {
        const times = hits.map(i => W[i].t.toFixed(3) + "s").join(", ");
        throw new Error(`landOn: phrase "${phrase}" matches ${hits.length} occurrences at [${times}]. Use a longer phrase to disambiguate.`);
      }
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase) { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, duration) { return at(phrase) - (duration || 0); }
    function landAfter(phrase, duration) { return W[_findPhrase(phrase).endIdx].e - (duration || 0); }

    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });

    // Eyebrow "THIS IS" fades in early anchored to "This is" phrase start
    tl.to("#beat6-eyebrow", {
      opacity: 1,
      duration: 0.30,
      ease: "power2.out"
    }, landOn("This is", 0.30));

    // "COMPOUND" mask wipe: clip-path inset 0 0 100% 0 -> 0 0 0 0
    tl.to("#beat6-compound", {
      clipPath: "inset(0 0 0% 0)",
      duration: 0.40,
      ease: "power3.out"
    }, landOn("compound", 0.40));

    // "INTEREST" slides in from y=80
    tl.fromTo("#beat6-interest", {
      y: 80,
      opacity: 0
    }, {
      y: 0,
      opacity: 1,
      duration: 0.45,
      ease: "power3.out"
    }, landOn("interest.", 0.45));

    // Blue accent underline draws left to right
    tl.to("#beat6-underline", {
      scaleX: 1,
      duration: 0.35,
      ease: "power2.out"
    }, landOn("interest.", 0.50) + 0.10);

    // Reaction on "interest." word: scale pulse on INTEREST headline
    tl.to("#beat6-interest", {
      scale: 1.03,
      duration: 0.12,
      ease: "power2.out",
      yoyo: true,
      repeat: 1
    }, at("interest."));

    tl.set("#beat6", { visibility: "hidden" }, 2.80);

    window.__timelines["bloom-compound-interest-beat-6"] = tl;
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 22.95); tl.resume();
  }
})();

