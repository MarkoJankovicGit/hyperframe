      { word: "started",   t: 5.344, e: 5.694 },
      { word: "early,",    t: 5.761, e: 6.336 },
      { word: "can",       t: 6.356, e: 6.416 },
      { word: "become",    t: 6.473, e: 6.815 },
      { word: "truly",     t: 6.895, e: 7.295 },
      { word: "massive",   t: 7.365, e: 7.855 },
      { word: "over",      t: 7.919, e: 8.175 },
      { word: "time.",     t: 8.239, e: 8.575 }
    ];

    // ── PHRASE-ANCHORED TIMING HELPERS ────────────────────────────────────
    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found`);
      if (hits.length > 1) throw new Error(`landOn: phrase "${phrase}" ambiguous`);
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase) { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, duration) { return at(phrase) - (duration || 0); }

    // ── SPARKLINE: stroke-dashoffset draw-in ─────────────────────────────
    const path = document.getElementById("beat12-sparkline-path");
    const pathLen = path.getTotalLength();
    gsap.set(path, { strokeDasharray: pathLen, strokeDashoffset: pathLen });

    // Draw sparkline on "compound interest." — completes around e of "interest."
    const sparkStart = landOn("compound", 0);
    const sparkDur = W[_findPhrase("interest.").endIdx].e - sparkStart;
    tl.to(path, {
      strokeDashoffset: 0,
      duration: sparkDur,
      ease: "power2.inOut",
      overwrite: "auto"
    }, sparkStart);

    // Dot at tip: appears as sparkline completes
    tl.to("#beat12-dot", {
      opacity: 1,
      duration: 0.18,
      ease: "power2.out",
      overwrite: "auto"
    }, W[_findPhrase("interest.").endIdx].e - 0.15);

    // ── HEADLINE word-by-word drop-in ─────────────────────────────────────
    const hwEls = document.querySelectorAll(".beat12-hw");
    // "Stocks" at t=0.148, "build wealth" — map to W words
    const headlineWords = ["Stocks", "build", "wealth"];
    hwEls.forEach((el, i) => {
      tl.from(el, {
        y: -50,
        opacity: 0,
        duration: 0.45,
        ease: "expo.out",
        overwrite: "auto"
      }, landOn(headlineWords[i], 0.35));
    });

    // ── CHIP POP-INS ──────────────────────────────────────────────────────
    // Chip 1 (AAPL) on "Small amounts,"
    tl.to("#beat12-chip-aapl", {
      opacity: 1,
      scale: 1,
      duration: 0.4,
      ease: "back.out(1.7)",
      overwrite: "auto"
    }, landOn("Small amounts,", 0.3));

    // Chip 2 (NKE) on "started early,"
    tl.to("#beat12-chip-nke", {
      opacity: 1,
      scale: 1,
      duration: 0.4,
      ease: "back.out(1.7)",
      overwrite: "auto"
    }, landOn("started early,", 0.3));

    // Chip 3 (SBUX) on "truly massive"
    tl.to("#beat12-chip-sbux", {
      opacity: 1,
      scale: 1,
      duration: 0.4,
      ease: "back.out(1.7)",
      overwrite: "auto"
    }, landOn("truly massive", 0.3));

    // ── CHIP IDLE: gentle scale yoyo (staggered 0.25s) ────────────────────
    const chipIds = ["#beat12-chip-aapl", "#beat12-chip-nke", "#beat12-chip-sbux"];
    const chipOnTimes = [
      landOn("Small amounts,", 0.3) + 0.4,
      landOn("started early,", 0.3) + 0.4,
      landOn("truly massive",  0.3) + 0.4
    ];
    chipIds.forEach((id, i) => {
      tl.to(id, {
        scale: 1.02,
        duration: 1.6,
        ease: "sine.inOut",
        yoyo: true,
        repeat: 1,
        overwrite: "auto"
      }, chipOnTimes[i] + i * 0.25);
    });

    // ── SPARKLINE IDLE: gentle y yoyo ─────────────────────────────────────
    const sparklineIdleStart = W[_findPhrase("interest.").endIdx].e + 0.1;
    tl.to("#beat12-sparkline-wrap", {
      y: -4,
      duration: 1.5,
      ease: "sine.inOut",
      yoyo: true,
      repeat: 1,
      overwrite: "auto"
    }, sparklineIdleStart);

    // ── SUBTITLE SLIDE-IN on "over time." ─────────────────────────────────
    tl.from("#beat12-subtitle", {
      y: 40,
      opacity: 0,
      duration: 0.5,
      ease: "power3.out",
      overwrite: "auto"
    }, landOn("over time.", 0.4));
    // Ensure opacity:1 is set (from() starts at 0 and lands at CSS 0, so also set to)
    tl.set("#beat12-subtitle", { opacity: 1 }, landOn("over time.", 0.4));

    // ── DOT PULSE on "over time." ─────────────────────────────────────────
    tl.to("#beat12-dot", {
      r: 26,
      duration: 0.22,
      ease: "power2.out",
      yoyo: true,
      repeat: 1,
      overwrite: "auto"
    }, at("over time."));

    // ── KILL VISIBILITY at composition end ────────────────────────────────
    tl.set("#beat12", { visibility: "hidden" }, 8.70);
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 56.3); tl.resume();
  }
})();

// ====== BEAT 13 (cta) start=65.00 dur=8.30 ======
(function(){
// ── TIMELINE REGISTRATION ─────────────────────────────────────────────
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    window.__timelines["bloom-compound-interest-beat-13"] = tl;

    // ── VO WORD TIMING (beat-relative) ────────────────────────────────────
    const W = [
      { word: "Bloom",     t: 0.088, e: 1.153 },
      { word: "has",       t: 1.193, e: 1.313 },
      { word: "a",         t: 1.393, e: 1.473 },
      { word: "tool",      t: 1.537, e: 1.793 },
      { word: "called",    t: 1.85,  e: 2.192 },
      { word: "Potential", t: 2.248, e: 2.752 },
      { word: "Return",    t: 2.832, e: 3.312 },
      { word: "that",      t: 3.408, e: 3.792 },
      { word: "shows",     t: 3.845, e: 4.11  },
      { word: "you",       t: 4.15,  e: 4.27  },
      { word: "exactly",   t: 4.36,  e: 4.99  },
      { word: "how",       t: 5.03,  e: 5.15  },
      { word: "much",      t: 5.198, e: 5.39  },
      { word: "your",      t: 5.422, e: 5.55  },
      { word: "money",     t: 5.603, e: 5.868 },
      { word: "could",     t: 5.895, e: 6.03  },
      { word: "grow.",     t: 6.11,  e: 6.51  },
      { word: "Try",       t: 6.71,  e: 7.31  },
      { word: "it",        t: 7.337, e: 7.391 },
      { word: "out.",      t: 7.471, e: 7.791 }
    ];

    // ── PHRASE-ANCHORED TIMING HELPERS ────────────────────────────────────
    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found`);
      if (hits.length > 1) {
        const times = hits.map(i => W[i].t.toFixed(3) + "s").join(", ");
        throw new Error(`landOn: phrase "${phrase}" matches ${hits.length} occurrences at [${times}]. Use a longer phrase.`);
      }
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase)               { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, dur = 0)  { return at(phrase) - dur; }

    // ── DETERMINISTIC PRNG (mulberry32, seed=13) ──────────────────────────
    function mulberry32(seed) {
      return function () {
        let t = (seed += 0x6d2b79f5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // ── CANVAS TICKER TAPE ─────────────────────────────────────────────────
    const canvas = document.getElementById("beat13-canvas");
    const ctx    = canvas.getContext("2d");
    canvas.width  = 1080;
    canvas.height = 1920;

    const rand = mulberry32(13);
    const TICKERS = ["8%", "10%", "$1K", "12%", "GROW", "$5K", "APY", "WIN", "3x"];
    const tickerList = [];
    for (let i = 0; i < 22; i++) {
      tickerList.push({
        label: TICKERS[Math.floor(rand() * TICKERS.length)],
        x:     Math.floor(rand() * 1080),
        y:     Math.floor(rand() * 2120) - 100,
        speed: 12 + Math.floor(rand() * 8)
      });
    }

    function drawTicker(t) {
      ctx.clearRect(0, 0, 1080, 1920);
      ctx.fillStyle = "rgba(255,255,255,0.55)";
      ctx.font = "bold 28px Inter";
      ctx.textAlign = "center";
      tickerList.forEach(item => {
        const y = ((item.y + t * item.speed) % 2220 + 2220) % 2220;
        ctx.fillText(item.label, item.x, y);
      });
    }

    // Canvas proxy for deterministic time scrubbing
    const canvasProxy = { time: 0 };
    tl.to("#beat13-canvas", { opacity: 0.25, duration: 0.4, ease: "power2.out" }, 0);
    tl.to(canvasProxy, {
      time: 8.30,
      duration: 8.30,
      ease: "none",
      onUpdate: () => drawTicker(canvasProxy.time)
    }, 0);

    // ── ANIMATIONS ─────────────────────────────────────────────────────────

    // --- Logo: scale-bounce entrance on "Bloom has" ---
    const tLogo = landOn("Bloom has", 0.55);
    tl.from("#beat13-logo", {
      scale: 0,
      opacity: 0,
      duration: 0.55,
      ease: "back.out(1.7)",
      overwrite: "auto"
    }, tLogo);

    // Logo breathe idle: scale 1.04 yoyo sine, 1.8s, repeat 2 (covers ~3.6s of idle)
    tl.to("#beat13-logo", {
      scale: 1.04,
      duration: 1.8,
      ease: "sine.inOut",
      yoyo: true,
      repeat: 2,
      overwrite: "auto"
    }, tLogo + 0.55);

    // --- Badge: SLAMS in on "Potential Return" ---
    const tBadge = landOn("Potential Return", 0.5);
    tl.from("#beat13-badge", {
      scale: 0,
      opacity: 0,
      duration: 0.5,
      ease: "back.out(1.4)",
      overwrite: "auto"
    }, tBadge);

    // Badge line1 staggered entrance slightly after badge
    tl.from("#beat13-badge-line1", {
      y: 30,
      opacity: 0,
      duration: 0.35,
      ease: "power3.out",
      overwrite: "auto"
    }, tBadge + 0.12);

    tl.from("#beat13-badge-line2", {
      y: 40,
      opacity: 0,
      duration: 0.40,
      ease: "expo.out",
      overwrite: "auto"
    }, tBadge + 0.22);

    // --- Subline: mask-wipe in on "shows you" ---
    const tSubline = landOn("shows you", 0);
    tl.to("#beat13-subline", {
      clipPath: "inset(0 0% 0 0)",
      duration: 0.55,
      ease: "power2.inOut",
      overwrite: "auto"
    }, tSubline);

    // --- Sparkline pill: slide-up on "could grow." ---
    const tPill = landOn("could grow.", 0);
    tl.from("#beat13-pill", {
      y: 80,
      opacity: 0,
      duration: 0.5,
      ease: "power3.out",
      overwrite: "auto"
    }, tPill);

    // Sparkline draw-on effect via stroke-dasharray
    const sparkEl = document.getElementById("beat13-sparkline-path");
    const sparkLen = 450; // approximate polyline length
    gsap.set(sparkEl, { strokeDasharray: sparkLen, strokeDashoffset: sparkLen });
    tl.to(sparkEl, {
      strokeDashoffset: 0,
      duration: 0.7,
      ease: "power2.out",
      overwrite: "auto"
    }, tPill + 0.1);

    // --- CTA pill: slams in on "Try it out." ---
    const tCta = landOn("Try it out.", 0);
    tl.from("#beat13-cta", {
      scale: 0,
      opacity: 0,
      duration: 0.38,
      ease: "back.out(1.5)",
      overwrite: "auto"
    }, tCta);

    // CTA overshoot then settle: scale 1.06 -> 1
    tl.to("#beat13-cta", {
      scale: 1.06,
      duration: 0.18,
      ease: "power1.out",
      overwrite: "auto"
    }, tCta + 0.38);
    tl.to("#beat13-cta", {
      scale: 1.0,
      duration: 0.22,
      ease: "power2.inOut",
      overwrite: "auto"
    }, tCta + 0.56);

    // CTA shake: x jitter, 1 cycle
    tl.to("#beat13-cta", {
      x: -6,
      duration: 0.06,
      ease: "none",
      repeat: 3,
      yoyo: true,
      overwrite: "auto"
    }, tCta + 0.78);

    // ── KILL at 8.30s ─────────────────────────────────────────────────────
    tl.set("#beat13", { visibility: "hidden" }, 8.30);
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 65); tl.resume();
  }
})();

</body>
</html>
