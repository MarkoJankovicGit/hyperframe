    /* Badge */
    #beat8-badge {
      background: #1C2329;
      border-radius: 26px;
      padding: 50px 80px;
      box-shadow: 0 24px 60px rgba(6, 10, 30, 0.28);
      display: flex;
      align-items: center;
      justify-content: center;
      transform-origin: center center;
    }

    #beat8-badge-text {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 210px;
      text-transform: uppercase;
      color: #FFFFFF;
      letter-spacing: -0.02em;
      line-height: 1;
      white-space: nowrap;
    }

    /* Subline */
    #beat8-subline {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 700;
      font-style: italic;
      font-size: 64px;
      text-transform: uppercase;
      color: #1658FF;
      letter-spacing: 0.04em;
      text-align: center;
      clip-path: inset(0 100% 0 0);
    }

/* ====== BEAT 9 (earlier) ====== */
#beat9 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #1658FF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
