// ====== BEAT 8 (superpower) start=33.75 dur=6.20 ======
(function(){
// ── TIMELINE REGISTRATION ────────────────────────────────────────────
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    window.__timelines["bloom-compound-interest-beat-8"] = tl;

    // ── VO WORD TIMING (beat-relative) ────────────────────────────────────
    const W = [
      { word: "Compound",   t: 0.002, e: 1.138 },
      { word: "interest",   t: 1.191, e: 1.615 },
      { word: "is",         t: 1.668, e: 1.774 },
      { word: "a",          t: 1.814, e: 1.854 },
      { word: "superpower", t: 1.947, e: 2.652 },
      { word: "that",       t: 2.716, e: 2.972 },
      { word: "makes",      t: 3.012, e: 3.212 },
      { word: "your",       t: 3.244, e: 3.372 },
      { word: "money",      t: 3.412, e: 3.612 },
      { word: "grow",       t: 3.676, e: 3.932 },
      { word: "faster",     t: 4.023, e: 4.569 },
      { word: "and",        t: 4.629, e: 4.809 },
      { word: "faster",     t: 4.889, e: 5.369 },
      { word: "over",       t: 5.417, e: 5.609 },
      { word: "time.",      t: 5.689, e: 6.089 }
    ];

    // ── PHRASE-ANCHORED TIMING HELPERS ────────────────────────────────────
    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error("landOn: empty phrase");
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found`);
      if (hits.length > 1) {
        const times = hits.map(i => W[i].t.toFixed(3) + "s").join(", ");
        throw new Error(`landOn: phrase "${phrase}" matches ${hits.length} occurrences at [${times}]. Use a longer phrase.`);
      }
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase) { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, duration) { return at(phrase) - (duration || 0); }

    // ── SEEDED PRNG ───────────────────────────────────────────────────────
    function mulberry32(seed) {
      return function () {
        let t = (seed += 0x6d2b79f5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // ── CANVAS PARTICLES ─────────────────────────────────────────────────
    const canvas = document.getElementById("beat8-canvas");
    const ctx = canvas.getContext("2d");
    // Badge center in the 1080x1920 canvas (approximately vertical center)
    const BADGE_CX = 540;
    const BADGE_CY = 960;

    const rand = mulberry32(42);
    const PARTICLE_COUNT = 60;
    const particles = [];
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const angle = rand() * Math.PI * 2;
      const speed = 180 + rand() * 320;
      const isYellow = i < 30;
      particles.push({
        angle: angle,
        speed: speed,
        radius: 4 + Math.floor(rand() * 7),
        color: isYellow ? "#FFD700" : "#FFFFFF",
        life: 0.55 + rand() * 0.45
      });
    }

    // Particle proxy: t goes from 0 to 1 during burst window
    const particleProxy = { t: 0, active: false };

    function drawParticles(progress) {
      ctx.clearRect(0, 0, 1080, 1920);
      if (!particleProxy.active || progress <= 0) return;
      const t = Math.min(progress, 1);
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const age = t / p.life;
        if (age > 1) continue;
        const dist = p.speed * t;
        const x = BADGE_CX + Math.cos(p.angle) * dist;
        const y = BADGE_CY + Math.sin(p.angle) * dist;
        const alpha = 1 - age;
        ctx.globalAlpha = alpha;
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(Math.round(x), Math.round(y), p.radius, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    // ── STAR ROTATION ─────────────────────────────────────────────────────
    // 6.20s duration: we want continuous 0->360 over 12s, so 1 repeat is enough
    // repeat count = ceil(6.20 / 12) - 1 = 0, so single forward tween covers it
    tl.to(
      "#beat8-star",
      {
        rotation: 185,   // 360 * (6.20/12) ~= 185.6
        duration: 6.20,
        ease: "none",
        transformOrigin: "50% 50%",
        overwrite: "auto"
      },
      0
    );

    // ── EYEBROW: fade in on "Compound interest" ───────────────────────────
    tl.from(
      "#beat8-eyebrow",
      {
        opacity: 0,
        y: -24,
        duration: 0.4,
        ease: "power2.out",
        overwrite: "auto"
      },
      landOn("Compound interest", 0.4)
    );

    // ── BADGE: slam in on "superpower" ────────────────────────────────────
    tl.from(
      "#beat8-badge",
      {
        scale: 0.7,
        opacity: 0,
        duration: 0.5,
        ease: "back.out(1.7)",
        overwrite: "auto"
      },
      landOn("superpower", 0.5)
    );

    // Particle burst fires when badge lands
    tl.to(
      particleProxy,
      {
        t: 1,
        duration: 0.9,
        ease: "none",
        onStart: () => { particleProxy.active = true; },
        onUpdate: () => drawParticles(particleProxy.t),
        onComplete: () => { ctx.clearRect(0, 0, 1080, 1920); }
      },
      at("superpower")
    );

    // ── SUBLINE: mask-wipe in on "faster and" ────────────────────────────
    tl.to(
      "#beat8-subline",
      {
        clipPath: "inset(0 0% 0 0)",
        duration: 0.55,
        ease: "power3.out",
        overwrite: "auto"
      },
      landOn("faster and", 0)
    );

    // ── BADGE REACTION on "time." ─────────────────────────────────────────
    tl.to(
      "#beat8-badge",
      {
        scale: 1.04,
        duration: 0.18,
        ease: "power2.out",
        overwrite: "auto"
      },
      at("time.")
    );
    tl.to(
      "#beat8-badge",
