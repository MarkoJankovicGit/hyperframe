// ====== BEAT 11 (mega-slam) start=52.75 dur=3.55 ======
(function(){
// ── TIMELINE REGISTRATION ────────────────────────────────────────────
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    window.__timelines["bloom-compound-interest-beat-11"] = tl;

    // ── VO WORD TIMING (beat-relative) ───────────────────────────────────
    const W = [
      { word: "It",          t: 0.077, e: 0.451 },
      { word: "would",       t: 0.478, e: 0.613 },
      { word: "be",          t: 0.666, e: 0.772 },
      { word: "one",         t: 0.852, e: 1.092 },
      { word: "hundred",     t: 1.142, e: 1.492 },
      { word: "and",         t: 1.572, e: 1.812 },
      { word: "seventy-two", t: 1.882, e: 2.532 },
      { word: "million",     t: 2.582, e: 2.932 },
      { word: "dollars.",    t: 2.992, e: 3.492 }
    ];

    // ── PHRASE-ANCHORED TIMING HELPERS ────────────────────────────────────
    function _norm(s) { return s.toLowerCase().replace(/[^\p{L}\p{N}'-]/gu, ""); }
    function _findPhrase(phrase) {
      const tokens = phrase.toLowerCase().split(/\s+/).map(_norm).filter(Boolean);
      if (!tokens.length) throw new Error(`landOn: empty phrase`);
      const hits = [];
      for (let i = 0; i <= W.length - tokens.length; i++) {
        let ok = true;
        for (let j = 0; j < tokens.length; j++) {
          if (_norm(W[i + j].word) !== tokens[j]) { ok = false; break; }
        }
        if (ok) hits.push(i);
      }
      if (hits.length === 0) throw new Error(`landOn: phrase "${phrase}" not found`);
      if (hits.length > 1) throw new Error(`landOn: phrase "${phrase}" is ambiguous`);
      return { startIdx: hits[0], endIdx: hits[0] + tokens.length - 1 };
    }
    function at(phrase)           { return W[_findPhrase(phrase).startIdx].t; }
    function landOn(phrase, dur)  { return at(phrase) - (dur || 0); }
    function landAfter(phrase, dur){ return W[_findPhrase(phrase).endIdx].e - (dur || 0); }

    // ── MULBERRY32 PRNG (seed 171) ────────────────────────────────────────
    function mulberry32(seed) {
      return function() {
        let t = (seed += 0x6d2b79f5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    // ── CONFETTI SETUP ────────────────────────────────────────────────────
    const confettiCanvas = document.getElementById("beat11-confetti");
    const ctx = confettiCanvas.getContext("2d");
    confettiCanvas.width  = 1080;
    confettiCanvas.height = 1920;

    const rand = mulberry32(171);
    const CONFETTI_COLORS = ["#FFFFFF", "#EFC42C", "#01CD74"];
    const PIECE_COUNT = 120;

    const pieces = [];
    for (let i = 0; i < PIECE_COUNT; i++) {
      pieces.push({
        x:      rand() * 1080,
        y:      -rand() * 1920,           // start above canvas
        w:      12 + rand() * 20,
        h:      6  + rand() * 10,
        rot:    rand() * 360,
        speed:  260 + rand() * 320,       // px/s
        rotSpd: 60  + rand() * 180,       // deg/s
        color:  CONFETTI_COLORS[Math.floor(rand() * 3)]
      });
    }

    function drawConfetti(elapsed) {
      ctx.clearRect(0, 0, 1080, 1920);
      const beatEnd = 3.55;
      for (const p of pieces) {
        const y = p.y + elapsed * p.speed;
        if (y > 1920 + 40) continue;
        const angle = (p.rot + elapsed * p.rotSpd) * Math.PI / 180;
        ctx.save();
        ctx.translate(p.x, y);
        ctx.rotate(angle);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
        ctx.restore();
      }
    }

    // Confetti proxy for GSAP-driven time
    const confettiProxy = { elapsed: 0 };

    // Confetti tween: fade in on "seventy-two" and run to end
    const confettiStart = at("seventy-two");
    const confettiDur   = 3.55 - confettiStart;

    tl.to("#beat11-confetti", { opacity: 1, duration: 0.2, ease: "power2.out" }, confettiStart);
    tl.to(confettiProxy, {
      elapsed: confettiDur,
      duration: confettiDur,
      ease: "none",
      onUpdate: () => drawConfetti(confettiProxy.elapsed)
    }, confettiStart);

    // ── COUNTER NUMBER ANIMATION ──────────────────────────────────────────
    // Counter target: lands as narrator finishes saying "million dollars." minus 1.4s
    const counterLandTime = landAfter("million dollars.", 1.4);
    // Entrance: counter fades in on "It would" start
    const counterEnterTime = at("It would");

    const counterEl   = document.getElementById("beat11-counter");
    const counterProxy = { value: 0 };

    // Fade in
    tl.to("#beat11-counter", { opacity: 1, duration: 0.4, ease: "power2.out", overwrite: "auto" }, counterEnterTime);

    // Number ramp: 0 → 172,000,000
    const rampDur = counterLandTime - counterEnterTime;
    tl.to(counterProxy, {
      value: 172000000,
      duration: Math.max(rampDur, 0.5),
      ease: "power3.out",
      onUpdate: function() {
        const v = Math.round(counterProxy.value);
        counterEl.textContent = "$" + v.toLocaleString("en-US");
      }
    }, counterEnterTime);

    // ── EYEBROW ENTRANCE ──────────────────────────────────────────────────
    tl.from("#beat11-eyebrow", {
      y: -40,
      opacity: 0,
      duration: 0.45,
      ease: "expo.out",
      overwrite: "auto"
    }, landOn("one hundred", 0.35));
    tl.to("#beat11-eyebrow", { opacity: 1, duration: 0.45, ease: "expo.out", overwrite: "auto" }, landOn("one hundred", 0.35));

    // ── LABEL ENTRANCE ────────────────────────────────────────────────────
    tl.from("#beat11-label", {
      y: 30,
      opacity: 0,
      duration: 0.4,
      ease: "power3.out",
      overwrite: "auto"
    }, at("million"));
    tl.to("#beat11-label", { opacity: 1, duration: 0.4, ease: "power3.out", overwrite: "auto" }, at("million"));

    // ── COUNTER REACTION ON "dollars." ───────────────────────────────────
    const dollarTime = at("dollars.");

    // Scale pulse: 1 → 1.05 → 1
    tl.to("#beat11-counter", {
      scale: 1.05,
      duration: 0.12,
      ease: "power2.out",
      yoyo: true,
      repeat: 1,
      overwrite: "auto"
    }, dollarTime);

    // Shake rotation: 0 → 1 → -1 → 0
    tl.to("#beat11-counter", {
      rotation: 1,
      duration: 0.07,
      ease: "none",
      yoyo: true,
      repeat: 3,
      overwrite: "auto"
    }, dollarTime + 0.1);

    // ── VISIBILITY KILL ───────────────────────────────────────────────────
    tl.set("#beat11", { visibility: "hidden" }, 3.55);
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 52.75); tl.resume();
  }
})();

