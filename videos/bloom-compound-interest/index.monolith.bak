      height: 1920px;
      background: #1658FF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Confetti canvas — full bleed, below content */
    #beat11-confetti {
      position: absolute;
      top: 0;
      left: 0;
      width: 1080px;
      height: 1920px;
      z-index: 1;
      opacity: 0;
    }

    /* Content stack — centered column */
    #beat11-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 32px;
      text-align: center;
    }

    /* Eyebrow: "JUST 5 DAYS EARLIER" */
    #beat11-eyebrow {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-size: 70px;
      font-weight: 800;
      font-style: italic;
      text-transform: uppercase;
      color: #EFC42C;
      letter-spacing: -0.012em;
      line-height: 1;
      opacity: 0;
    }

    /* Hero counter: $172,000,000 */
    #beat11-counter {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-size: 240px;
      font-weight: 800;
      font-style: italic;
      color: #FFFFFF;
      letter-spacing: -0.03em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      filter: drop-shadow(0 0 48px rgba(239, 196, 44, 0.45)) drop-shadow(0 16px 40px rgba(0, 0, 0, 0.35));
      opacity: 0;
      white-space: nowrap;
    }

    /* Sub-label: "WITH COMPOUND INTEREST" */
    #beat11-label {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-size: 36px;
      font-weight: 700;
      color: #FFFFFF;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      opacity: 0;
    }

/* ====== BEAT 12 (stocks) ====== */
#beat12 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Headline */
    #beat12-headline {
      position: relative;
      z-index: 2;
      text-align: center;
      max-width: 940px;
      line-height: 1.05;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 140px;
      text-transform: uppercase;
      color: #1C2329;
      letter-spacing: -0.03em;
      margin-bottom: 80px;
    }

    #beat12-headline .beat12-hw {
      display: inline-block;
      opacity: 0;
      margin: 0 0.06em;
    }

    /* Sparkline wrapper */
    #beat12-sparkline-wrap {
      position: relative;
      z-index: 2;
      width: 700px;
      height: 300px;
      margin-bottom: 80px;
      flex-shrink: 0;
    }

    #beat12-sparkline-svg {
      width: 700px;
      height: 300px;
      overflow: visible;
    }

    #beat12-sparkline-path {
      fill: none;
      stroke: #01CD74;
      stroke-width: 14;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #beat12-dot {
      fill: #01CD74;
      r: 18;
      opacity: 0;
    }

    /* Chip row */
    #beat12-chips {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 60px;
      margin-bottom: 80px;
    }

    .beat12-chip {
      width: 180px;
      height: 180px;
      background: #1C2329;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 20px 50px rgba(28, 35, 41, 0.22);
      flex-shrink: 0;
      opacity: 0;
      scale: 0;
    }

    .beat12-chip img {
      width: 110px;
      height: 110px;
      object-fit: contain;
    }

    /* Subtitle */
    #beat12-subtitle {
      position: relative;
      z-index: 2;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 60px;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      color: #1658FF;
      text-align: center;
      opacity: 0;
    }

/* ====== BEAT 13 (cta) ====== */
#beat13 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #1658FF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Radial glow behind logo */
    #beat13-glow {
      position: absolute;
      top: 120px;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0) 70%);
      border-radius: 50%;
      z-index: 0;
      pointer-events: none;
    }

    /* Canvas ticker tape */
    #beat13-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 1080px;
      height: 1920px;
      opacity: 0;
      z-index: 0;
    }

    /* Main content column */
    #beat13-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      padding: 0 80px;
      gap: 52px;
    }

    /* Bloom logo */
    #beat13-logo {
      width: 220px;
      height: auto;
      display: block;
    }

    /* Hero badge */
    #beat13-badge {
      background: #1C2329;
      border-radius: 26px;
      padding: 60px 80px;
      box-shadow: 0 24px 60px rgba(6, 10, 30, 0.28);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    #beat13-badge-line1 {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 130px;
      color: #FFFFFF;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      line-height: 1.0;
    }

    #beat13-badge-line2 {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 170px;
      color: #01CD74;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      line-height: 1.0;
    }

    /* Subline */
    #beat13-subline {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 60px;
      color: #FFFFFF;
      text-transform: uppercase;
      letter-spacing: -0.012em;
      text-align: center;
      clip-path: inset(0 100% 0 0);
    }

    /* Sparkline pill / mini preview */
    #beat13-pill {
      width: 540px;
      height: 200px;
      background: #FFFFFF;
      border-radius: 60px;
      box-shadow: 0 16px 48px rgba(6, 10, 30, 0.22);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      overflow: hidden;
    }

    #beat13-sparkline-wrap {
      width: 420px;
      height: 80px;
      flex-shrink: 0;
    }

    #beat13-sparkline-wrap svg {
      width: 100%;
      height: 100%;
    }

    #beat13-pill-label {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 700;
      font-size: 36px;
      color: #1C2329;
      letter-spacing: -0.012em;
    }

    /* CTA pill */
    #beat13-cta {
      background: #1C2329;
      border-radius: 300px;
      padding: 36px 64px;
      box-shadow: 0 20px 50px rgba(6, 10, 30, 0.30);
    }

    #beat13-cta-text {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 80px;
      color: #FFFFFF;
      text-transform: uppercase;
      letter-spacing: -0.018em;
      white-space: nowrap;
    }

  </style>
</head>
<body>
  <div id="root" data-composition-id="bloom-compound-interest" data-width="1080" data-height="1920" data-start="0" data-duration="73.3">
    <audio id="narration" class="clip" data-start="0" data-duration="73.3" data-track-index="0" data-volume="1" src="narration.mp3" muted></audio>
    
<!-- ====== BEAT 1 (hook) 0.00s -> 2.40s ====== -->
<div id="beat1" class="scene" data-composition-id="bloom-compound-interest-beat-1" data-width="1080" data-height="1920" data-start="0" data-duration="2.40">
      <canvas id="beat1-canvas"></canvas>
      <canvas id="beat1-confetti"></canvas>

      <div class="b1-eyebrow">
        <span class="b1-word" id="b1w-you">You</span>
        <span class="b1-word" id="b1w-just">just</span>
        <span class="b1-word" id="b1w-won">won</span>
      </div>

      <div class="b1-badge">
        <span class="b1-badge-text">LOTTERY</span>
      </div>
    </div>

<!-- ====== BEAT 2 (choice-a) 2.40s -> 6.10s ====== -->
<div id="beat2" class="scene" data-composition-id="bloom-compound-interest-beat-2" data-width="1080" data-height="1920" data-start="0" data-duration="3.90">

      <!-- Dotted grid canvas -->
      <canvas id="beat2-grid"></canvas>

      <!-- Eyebrow headline -->
      <div class="b2-eyebrow">Your Choice</div>

      <!-- Option A card -->
      <div class="b2-card">
        <div class="b2-pill">Option A</div>
        <div class="b2-counter" id="b2-counter-display">$0</div>
        <div class="b2-subtitle" id="b2-rightnow">Right Now</div>
      </div>

      <!-- Coin stack SVG (decorative, right of card) -->
      <div class="b2-coin" id="b2-coin">
        <svg class="b2-coin-svg" viewBox="0 0 120 140" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- Stack of 3 coins -->
          <ellipse cx="60" cy="120" rx="50" ry="14" fill="#01CD74" opacity="0.22"/>
          <rect x="10" y="98" width="100" height="22" rx="11" fill="#01CD74" opacity="0.55"/>
          <ellipse cx="60" cy="98" rx="50" ry="14" fill="#01CD74" opacity="0.80"/>

          <ellipse cx="60" cy="82" rx="50" ry="14" fill="#01CD74" opacity="0.22"/>
          <rect x="10" y="60" width="100" height="22" rx="11" fill="#01CD74" opacity="0.60"/>
          <ellipse cx="60" cy="60" rx="50" ry="14" fill="#01CD74" opacity="0.85"/>

          <ellipse cx="60" cy="44" rx="50" ry="14" fill="#01CD74" opacity="0.22"/>
          <rect x="10" y="22" width="100" height="22" rx="11" fill="#01CD74" opacity="0.68"/>
          <ellipse cx="60" cy="22" rx="50" ry="14" fill="#01CD74"/>

          <!-- $ glyph on top coin -->
          <text x="60" y="30" text-anchor="middle" dominant-baseline="middle"
            font-family="Inter Tight, system-ui, sans-serif" font-weight="800"
            font-size="22" fill="#FFFFFF" letter-spacing="-1">$</text>
        </svg>
      </div>

    </div>

<!-- ====== BEAT 3 (choice-b) 6.10s -> 12.00s ====== -->
<div id="beat3" class="scene" data-composition-id="bloom-compound-interest-beat-3" data-width="1080" data-height="1920" data-start="0" data-duration="5.90">

      <div id="beat3-grid"></div>

      <div id="beat3-badge">OPTION B</div>

      <div id="beat3-coin-wrap">
        <div id="beat3-coin">
          <span id="beat3-coin-label">1¢</span>
        </div>
      </div>

      <div id="beat3-dots-row">
        <!-- 30 dots injected by script -->
      </div>

      <div id="beat3-doubles-label">DOUBLES DAILY &times; 30 DAYS</div>

      <div id="beat3-headline">WHICH WOULD<br>YOU TAKE?</div>

    </div>

<!-- ====== BEAT 4 (stat-a) 12.00s -> 17.70s ====== -->
<div id="beat4" class="scene" data-composition-id="bloom-compound-interest-beat-4" data-width="1080" data-height="1920" data-start="0" data-duration="5.70">

      <div id="beat4-eyebrow">After 30 Days</div>

      <div id="beat4-counter">$0</div>

      <div id="beat4-sparkline-wrap">
        <div id="beat4-sparkline-track"></div>
        <div id="beat4-sparkline-fill"></div>
      </div>

      <div id="beat4-flat-label">Flat</div>

      <div id="beat4-badge">
        <span id="beat4-badge-text">Still Just $1M</span>
      </div>

    </div>

<!-- ====== BEAT 5 (stat-b) 17.70s -> 22.95s ====== -->
<div id="beat5" class="scene" data-composition-id="bloom-compound-interest-beat-5" data-width="1080" data-height="1920" data-start="0" data-duration="5.25">

      <!-- SVG glow filter -->
      <svg id="beat5-svg-filters" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="beat5-glow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="10" result="blur"/>
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
      </svg>

      <!-- Exponential growth curve -->
      <svg id="beat5-curve-svg" viewBox="0 0 1080 960" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <defs>
          <filter id="beat5-curve-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="12" result="blur"/>
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
        <!-- Exponential curve: bottom-left (80,940) sweeping to top-right (1000,40) -->
        <path id="beat5-curve-path"
          d="M80,940 C200,920 320,880 420,800 C520,720 580,600 660,460 C720,360 780,240 860,140 C920,70 970,42 1000,40"
          filter="url(#beat5-curve-glow)"
        />
      </svg>

      <!-- Penny dot -->
      <div id="beat5-penny-dot"></div>

      <!-- Spark trail canvas -->
      <canvas id="beat5-spark-canvas" width="1080" height="1920"></canvas>

      <!-- Particle burst canvas -->
      <canvas id="beat5-particle-canvas" width="1080" height="1920"></canvas>

      <!-- Eyebrow -->
      <div id="beat5-eyebrow">But the doubling penny?</div>

      <!-- Hero counter -->
      <div id="beat5-counter">$0</div>

      <!-- Subtitle -->
      <div id="beat5-subtitle">After 30 Days</div>

    </div>

<!-- ====== BEAT 6 (concept-name) 22.95s -> 25.75s ====== -->
<div id="beat6" class="scene" data-composition-id="bloom-compound-interest-beat-6" data-width="1080" data-height="1920" data-start="0" data-duration="2.80">

