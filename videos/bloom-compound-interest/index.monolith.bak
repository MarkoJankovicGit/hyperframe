        ease: "power3.out",
        overwrite: "auto"
      },
      landOn("really powerful:", 0.3)
    );

    // ── Arrow draws in from "earlier you" through "start," ─────────────
    const axisStart = landOn("earlier you", 0.05);
    const axisEnd   = landAfter("start,", 0);

    tl.to("#beat9-axis-line",
      {
        strokeDashoffset: 0,
        duration: axisEnd - axisStart,
        ease: "power2.inOut",
        overwrite: "auto"
      },
      axisStart
    );
    // arrowhead tip pops in when line finishes
    tl.to("#beat9-axis-tip",
      {
        opacity: 1,
        duration: 0.18,
        ease: "power2.out",
        overwrite: "auto"
      },
      axisEnd - 0.15
    );

    // ── EARLY peg + curve — appear on "earlier you" ────────────────────
    const earlyT = landOn("earlier you", 0);

    tl.to(
      ["#beat9-early-peg", "#beat9-early-label", "#beat9-early-arrow", "#beat9-early-arrowhead"],
      {
        opacity: 1,
        duration: 0.25,
        ease: "power2.out",
        stagger: 0.06,
        overwrite: "auto"
      },
