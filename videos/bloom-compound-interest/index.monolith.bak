    #beat9-eyebrow {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      text-transform: uppercase;
      font-size: 64px;
      color: #FFFFFF;
      letter-spacing: -0.01em;
      white-space: nowrap;
      /* clip-mask reveal: start clipped */
      clip-path: inset(0 100% 0 0);
    }

    /* ── TIME AXIS SVG ───────────────────────────────────────── */
    #beat9-axis-svg {
      width: 840px;
      height: 320px;
      overflow: visible;
      margin-bottom: 60px;
    }

    /* ── HEADLINES ───────────────────────────────────────────── */
    #beat9-headline {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      text-transform: uppercase;
      font-size: 130px;
      color: #FFFFFF;
      letter-spacing: -0.03em;
      line-height: 1.0;
      text-align: center;
      max-width: 960px;
    }

    #beat9-subline {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      text-transform: uppercase;
      font-size: 80px;
      color: #01CD74;
      letter-spacing: -0.02em;
      line-height: 1.0;
      text-align: center;
      max-width: 960px;
      margin-top: 24px;
    }

/* ====== BEAT 10 (mega-build) ====== */
#beat10 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* ── EYEBROW ─────────────────────────────────────────── */
    #beat10-eyebrow {
      position: absolute;
      top: 200px;
      left: 0;
      right: 0;
      text-align: center;
      font-family: "Inter Tight", system-ui, sans-serif;
