    tl.to("#beat9-subline",
      {
        scale: 1.0,
        duration: 0.28,
        ease: "elastic.out(1, 0.5)",
        overwrite: "auto"
      },
      favorT + 0.16
    );

    // ── Kill visibility at end ────────────────────────────────────────
    tl.set("#beat9", { visibility: "hidden" }, 6.35);
  // Add this beat's timeline to master at its start offset
  if (typeof tl !== 'undefined' && window.__masterTl) {
    window.__masterTl.add(tl, 39.95); tl.resume();
  }
})();

