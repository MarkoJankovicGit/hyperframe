<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1080, height=1920" />
  <title>Bloom Lesson — Compound Interest</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:ital,wght@0,700;0,800;1,700;1,800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 1080px;
      height: 1920px;
      overflow: hidden;
      background: #000;
      font-family: "Inter Tight", "Inter", system-ui, sans-serif;
    }
    #root {
      position: relative;
      width: 1080px;
      height: 1920px;
      overflow: hidden;
    }
    .scene {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      overflow: hidden;
    }
    #beat1 { background: #1658FF; opacity: 0; }
#beat2 { background: #FFFFFF; opacity: 0; }
#beat3 { background: #F8F8F9; opacity: 0; }
#beat4 { background: #FFFFFF; opacity: 0; }
#beat5 { background: #1658FF; opacity: 0; }
#beat6 { background: #FFFFFF; opacity: 0; }
#beat7 { background: #1658FF; opacity: 0; }
#beat8 { background: #FFFFFF; opacity: 0; }
#beat9 { background: #1658FF; opacity: 0; }
#beat10 { background: #FFFFFF; opacity: 0; }
#beat11 { background: #1658FF; opacity: 0; }
#beat12 { background: #FFFFFF; opacity: 0; }
#beat13 { background: #1658FF; opacity: 0; }
#beat1 { opacity: 1; }

    
/* ====== BEAT 1 (hook) ====== */
#beat1 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #1658FF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    #beat1-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 1080px;
      height: 1920px;
      opacity: 0;
      z-index: 1;
    }

    #beat1-confetti {
      position: absolute;
      top: 0;
      left: 0;
      width: 1080px;
      height: 1920px;
      z-index: 4;
      pointer-events: none;
    }

    #beat1 .b1-eyebrow {
      position: relative;
      z-index: 2;
      text-align: center;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 80px;
      color: #FFFFFF;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      line-height: 1.05;
      margin-bottom: 32px;
    }

    #beat1 .b1-word {
      display: inline-block;
      opacity: 0;
      margin: 0 0.08em;
    }

    #beat1 .b1-badge {
      position: relative;
      z-index: 3;
      background: #1C2329;
      border-radius: 26px;
      padding: 28px 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform-origin: center center;
    }

    #beat1 .b1-badge-text {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 210px;
      color: #FFFFFF;
      text-transform: uppercase;
      letter-spacing: -0.04em;
      line-height: 1.0;
      white-space: nowrap;
    }

/* ====== BEAT 2 (choice-a) ====== */
#beat2 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Dotted grid background */
    #beat2-grid {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      z-index: 0;
      pointer-events: none;
    }

    /* Eyebrow */
    #beat2 .b2-eyebrow {
      position: relative;
      z-index: 2;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 70px;
      text-transform: uppercase;
      color: #1C2329;
      letter-spacing: -0.02em;
      text-align: center;
      margin-bottom: 64px;
    }

    /* Card */
    #beat2 .b2-card {
      position: relative;
      z-index: 2;
      width: 760px;
      background: #FFFFFF;
      border-radius: 32px;
      box-shadow: 0 24px 80px rgba(22, 88, 255, 0.12), 0 4px 20px rgba(0, 0, 0, 0.06);
      border-top: 6px solid #01CD74;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 64px 56px 72px;
      gap: 0;
    }

    /* OPTION A pill */
    #beat2 .b2-pill {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 700;
      font-size: 26px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #01CD74;
      background: rgba(1, 205, 116, 0.10);
      border-radius: 100px;
      padding: 10px 28px;
      margin-bottom: 40px;
    }

    /* Giant counter */
    #beat2 .b2-counter {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 148px;
      color: #1658FF;
      letter-spacing: -0.04em;
      line-height: 1;
      text-align: center;
      font-variant-numeric: tabular-nums;
      margin-bottom: 32px;
    }

    /* RIGHT NOW subtitle */
    #beat2 .b2-subtitle {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-size: 48px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #1C2329;
      text-align: center;
    }

    /* Coin SVG cutout */
    #beat2 .b2-coin {
      position: absolute;
      z-index: 3;
      right: 64px;
      top: 50%;
      transform: translateY(-50%);
      width: 120px;
      height: 140px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    #beat2 .b2-coin-svg {
      width: 100%;
      height: auto;
      display: block;
    }

/* ====== BEAT 3 (choice-b) ====== */
#beat3 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #F8F8F9;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Dotted grid background */
    #beat3-grid {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background-image: radial-gradient(circle, rgba(22, 88, 255, 0.04) 1.5px, transparent 1.5px);
      background-size: 48px 48px;
      z-index: 0;
    }

    /* Option B badge */
    #beat3-badge {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #1C2329;
      color: #F8F8F9;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 42px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 18px 56px;
      border-radius: 100px;
      margin-bottom: 80px;
    }

    /* Penny coin */
    #beat3-coin-wrap {
      position: relative;
      z-index: 2;
      width: 200px;
      height: 200px;
      margin-bottom: 72px;
    }

    #beat3-coin {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      background: radial-gradient(circle at 38% 35%, #D4905C 0%, #B87333 55%, #8B5B24 100%);
      box-shadow:
        0 0 0 6px rgba(140, 90, 36, 0.25),
        0 20px 60px rgba(120, 70, 20, 0.45),
        inset 0 4px 12px rgba(255, 210, 160, 0.35),
        inset 0 -6px 18px rgba(60, 30, 0, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    /* Inner emboss ring */
    #beat3-coin::before {
      content: "";
      position: absolute;
      inset: 10px;
      border-radius: 50%;
      border: 2.5px solid rgba(255, 220, 170, 0.22);
    }

    /* 1¢ text */
    #beat3-coin-label {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 62px;
      color: rgba(255, 230, 185, 0.88);
      text-shadow: 0 2px 8px rgba(80, 40, 0, 0.55);
      letter-spacing: -0.02em;
      position: relative;
      z-index: 1;
      line-height: 1;
      user-select: none;
    }

    /* 30 penny dots row */
    #beat3-dots-row {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      flex-wrap: nowrap;
      gap: 10px;
      width: 960px;
      margin-bottom: 40px;
    }

    .beat3-dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #CACDD2;
      flex-shrink: 0;
      transition: none;
    }

    /* Doubles label */
    #beat3-doubles-label {
      position: relative;
      z-index: 2;
      font-family: "Inter", system-ui, sans-serif;
      font-weight: 600;
      font-size: 36px;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: #1C2329;
      margin-bottom: 0;
    }

    /* "Which would you take?" headline */
    #beat3-headline {
      position: relative;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #1C2329;
      color: #F8F8F9;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 90px;
      text-transform: uppercase;
      letter-spacing: -0.02em;
      line-height: 1.05;
      text-align: center;
      padding: 36px 64px;
      margin-top: 100px;
      max-width: 940px;
    }

/* ====== BEAT 4 (stat-a) ====== */
#beat4 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Eyebrow */
    #beat4-eyebrow {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 64px;
      text-transform: uppercase;
      color: #4A4F54;
      letter-spacing: 0.04em;
      text-align: center;
      line-height: 1.1;
      margin-bottom: 64px;
    }

    /* Counter */
    #beat4-counter {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 200px;
      color: #1C2329;
      letter-spacing: -0.03em;
      text-align: center;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    /* Flat sparkline container */
    #beat4-sparkline-wrap {
      margin-top: 56px;
      width: 600px;
      height: 48px;
      position: relative;
      display: flex;
      align-items: center;
    }

    #beat4-sparkline-track {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 600px;
      height: 4px;
      background: #E8EAEC;
      border-radius: 2px;
    }

    #beat4-sparkline-fill {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 0px;
      height: 4px;
      background: #C0C4C8;
      border-radius: 2px;
      transform-origin: left center;
    }

    /* FLAT label */
    #beat4-flat-label {
      margin-top: 24px;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 700;
      font-style: italic;
      font-size: 36px;
      text-transform: uppercase;
      color: #C0C4C8;
      letter-spacing: 0.1em;
      text-align: center;
    }

    /* Still-just badge */
    #beat4-badge {
      margin-top: 96px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #1C2329;
      border-radius: 12px;
      padding: 20px 48px;
      opacity: 0;
    }

    #beat4-badge-text {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 56px;
      text-transform: uppercase;
      color: #FFFFFF;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

/* ====== BEAT 5 (stat-b) ====== */
#beat5 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #1658FF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Glow filter for curve */
    #beat5-svg-filters {
      position: absolute;
      width: 0;
      height: 0;
    }

    /* Exponential curve SVG */
    #beat5-curve-svg {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 1080px;
      height: 960px;
      z-index: 1;
    }

    #beat5-curve-path {
      fill: none;
      stroke: #01CD74;
      stroke-width: 8;
      stroke-linecap: round;
      filter: url(#beat5-glow);
    }

    /* Penny dot that rides the curve */
    #beat5-penny-dot {
      position: absolute;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: radial-gradient(circle at 36% 36%, #FFE066 0%, #EFC42C 55%, #B8860B 100%);
      box-shadow: 0 0 24px 8px rgba(239, 196, 44, 0.7), 0 0 6px 2px rgba(255,224,102,0.9);
      z-index: 3;
      transform: translate(-50%, -50%);
    }

    /* Spark trail canvas */
    #beat5-spark-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 1080px;
      height: 1920px;
      z-index: 2;
      pointer-events: none;
    }

    /* Particle burst canvas */
    #beat5-particle-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 1080px;
      height: 1920px;
      z-index: 5;
      pointer-events: none;
    }

    /* Top eyebrow */
    #beat5-eyebrow {
      position: absolute;
      top: 160px;
      left: 0;
      right: 0;
      text-align: center;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 64px;
      text-transform: uppercase;
      color: #FFFFFF;
      letter-spacing: 0.01em;
      line-height: 1.1;
      z-index: 4;
    }

    /* Hero counter */
    #beat5-counter {
      position: relative;
      z-index: 4;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 220px;
      color: #FFFFFF;
      letter-spacing: -0.04em;
      line-height: 1.0;
      text-shadow: 0 8px 40px rgba(239, 196, 44, 0.55), 0 2px 8px rgba(239,196,44,0.35);
      font-variant-numeric: tabular-nums;
      margin-top: -40px;
    }

    /* Subtitle below counter */
    #beat5-subtitle {
      position: relative;
      z-index: 4;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 700;
      font-size: 36px;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: #FFFFFF;
      opacity: 0.88;
      margin-top: 20px;
    }

/* ====== BEAT 6 (concept-name) ====== */
#beat6 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    #beat6-grid {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background-image: radial-gradient(circle, rgba(22, 88, 255, 0.04) 1.5px, transparent 1.5px);
      background-size: 60px 60px;
      z-index: 0;
    }

    #beat6-content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    #beat6-eyebrow {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 56px;
      color: #4A4F54;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      line-height: 1.1;
      text-align: center;
      margin-bottom: 24px;
      opacity: 0;
    }

    #beat6-compound-wrap {
      overflow: hidden;
      margin-bottom: 8px;
    }

    #beat6-compound {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 200px;
      color: #1C2329;
      text-transform: uppercase;
      letter-spacing: -0.04em;
      line-height: 0.92;
      text-align: center;
      white-space: nowrap;
      clip-path: inset(0 0 100% 0);
    }

    #beat6-interest {
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 240px;
      color: #1658FF;
      text-transform: uppercase;
      letter-spacing: -0.04em;
      line-height: 0.92;
      text-align: center;
      white-space: nowrap;
      opacity: 0;
      margin-bottom: 20px;
    }

    #beat6-underline {
      width: 340px;
      height: 12px;
      background: #1658FF;
      transform-origin: left center;
      transform: scaleX(0);
    }

/* ====== BEAT 7 (concept-stack) ====== */
#beat7 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #1658FF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Canvas background */
    #beat7-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 1080px;
      height: 1920px;
      opacity: 0;
      z-index: 1;
    }

    /* Eyebrow label top */
    #beat7-eyebrow {
      position: absolute;
      top: 160px;
      left: 0;
      right: 0;
      text-align: center;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 800;
      font-style: italic;
      font-size: 56px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #FFFFFF;
      opacity: 0;
      z-index: 4;
    }

    /* Bottom label */
    #beat7-label {
      position: absolute;
      bottom: 200px;
      left: 0;
      right: 0;
      text-align: center;
      font-family: "Inter Tight", system-ui, sans-serif;
      font-weight: 700;
      font-size: 40px;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: #FFFFFF;
      opacity: 0;
      z-index: 4;
    }

    /* Ring stack container — flex-centered absolute */
    #beat7-stack {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 3;
    }

    /* Individual rings — all absolutely centered within stack */
    .beat7-ring {
      position: absolute;
      border-radius: 50%;
      transform-origin: center center;
      opacity: 0;
    }

    /* Ring 1 — core coin 60px gold */
    #beat7-ring-1 {
      width: 60px;
      height: 60px;
      background: radial-gradient(circle at 38% 38%, #EFC42C, #D4A017 70%);
      box-shadow: 0 0 18px rgba(239, 196, 44, 0.7);
    }

    /* Ring 2 — 110px gold with green halo */
    #beat7-ring-2 {
      width: 110px;
      height: 110px;
      background: radial-gradient(circle at 38% 38%, rgba(239, 196, 44, 0.55), rgba(212, 160, 23, 0.35) 70%);
      border: 2px solid rgba(1, 205, 116, 0.55);
      box-shadow: 0 0 24px rgba(1, 205, 116, 0.3);
    }

    /* Ring 3 — 170px warm gold */
    #beat7-ring-3 {
      width: 170px;
      height: 170px;
      background: radial-gradient(circle at 40% 40%, rgba(239, 196, 44, 0.45), rgba(212, 160, 23, 0.25) 70%);
      border: 2px solid rgba(239, 196, 44, 0.4);
    }

    /* Ring 4 — 240px pale gold */
    #beat7-ring-4 {
      width: 240px;
      height: 240px;
      background: radial-gradient(circle at 40% 40%, rgba(239, 196, 44, 0.32), rgba(212, 160, 23, 0.15) 70%);
      border: 2px solid rgba(239, 196, 44, 0.3);
    }

    /* Ring 5 — 320px green */
    #beat7-ring-5 {
      width: 320px;
      height: 320px;
      background: radial-gradient(circle at 40% 40%, rgba(1, 205, 116, 0.35), rgba(1, 205, 116, 0.12) 70%);
      border: 2px solid rgba(1, 205, 116, 0.5);
      box-shadow: 0 0 32px rgba(1, 205, 116, 0.2);
    }

    /* Ring 6 — 410px white */
    #beat7-ring-6 {
      width: 410px;
      height: 410px;
      background: radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.06) 70%);
      border: 2px solid rgba(255, 255, 255, 0.45);
    }

    /* Ring 7 — 510px pale yellow */
    #beat7-ring-7 {
      width: 510px;
      height: 510px;
      background: radial-gradient(circle at 40% 40%, rgba(255, 245, 190, 0.2), rgba(255, 245, 190, 0.05) 70%);
      border: 2px solid rgba(255, 245, 190, 0.4);
    }

    /* Ring 8 — 620px pale green */
    #beat7-ring-8 {
      width: 620px;
      height: 620px;
      background: radial-gradient(circle at 40% 40%, rgba(180, 255, 220, 0.15), rgba(180, 255, 220, 0.04) 70%);
      border: 2px solid rgba(180, 255, 220, 0.35);
    }

    /* Ring 9 — 740px white outermost with strong glow */
    #beat7-ring-9 {
      width: 740px;
      height: 740px;
      background: radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.03) 70%);
      border: 3px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 0 60px rgba(255, 255, 255, 0.25), inset 0 0 40px rgba(255, 255, 255, 0.06);
    }

/* ====== BEAT 8 (superpower) ====== */
#beat8 {
      position: absolute;
      inset: 0;
      width: 1080px;
      height: 1920px;
      background: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Bloom star background layer */
    #beat8-star {
      position: absolute;
      width: 620px;
      height: 620px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.18;
      z-index: 0;
      pointer-events: none;
    }

    /* Particle canvas */
    #beat8-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 1080px;
      height: 1920px;
      z-index: 1;
      pointer-events: none;
    }

    /* Main content stack */
    #beat8-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 52px;
      width: 100%;
      padding: 0 60px;
    }

    /* Eyebrow */
    #beat8-eyebrow {
      font-family: "Inter", system-ui, sans-serif;
