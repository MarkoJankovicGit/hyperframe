      <audio id="im2" class="clip" data-start="0.95" data-duration="0.6" data-track-index="24" data-volume="0.3" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
      <audio id="im3" class="clip" data-start="1.6"  data-duration="0.6" data-track-index="24" data-volume="0.3" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>

