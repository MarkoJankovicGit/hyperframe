      <!-- industry chip pops -->
      <audio id="ip1" class="clip" data-start="24.65" data-duration="0.4" data-track-index="31" data-volume="0.12" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="ip2" class="clip" data-start="25.54" data-duration="0.4" data-track-index="31" data-volume="0.12" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="ip3" class="clip" data-start="26.20" data-duration="0.4" data-track-index="31" data-volume="0.12" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="ip4" class="clip" data-start="27.00" data-duration="0.4" data-track-index="31" data-volume="0.12" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="ip5" class="clip" data-start="28.08" data-duration="0.4" data-track-index="31" data-volume="0.12" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="ilg" class="clip" data-start="29.3"  data-duration="0.7" data-track-index="32" data-volume="0.2" src="sound-effects/digital-bell-ding-demo-309885.mp3"></audio>

      <!-- engine card swaps -->
      <audio id="es1" class="clip" data-start="41.9" data-duration="0.5" data-track-index="26" data-volume="0.2" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="es2" class="clip" data-start="43.6" data-duration="0.5" data-track-index="26" data-volume="0.2" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="es3" class="clip" data-start="46.1" data-duration="0.5" data-track-index="26" data-volume="0.2" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="es4" class="clip" data-start="48.0" data-duration="0.5" data-track-index="26" data-volume="0.2" src="sound-effects/micro-air-swoosh_G18j6H4u.mp3"></audio>
      <audio id="eb1" class="clip" data-start="40.0" data-duration="0.7" data-track-index="30" data-volume="0.18" src="sound-effects/digital-beeping-151921.mp3"></audio>

      <!-- expand sfx -->
      <audio id="ex1" class="clip" data-start="33.5" data-duration="0.6" data-track-index="27" data-volume="0.2" src="sound-effects/digital-bell-ding-demo-309885.mp3"></audio>
      <audio id="ex2" class="clip" data-start="34.7" data-duration="0.6" data-track-index="27" data-volume="0.2" src="sound-effects/digital-bell-ding-demo-309885.mp3"></audio>

      <!-- numbers + riser -->
      <audio id="sfx-count" class="clip" data-start="54.4" data-duration="1.2" data-track-index="28" data-volume="0.4" src="sound-effects/data-reveal-sound-6460.mp3"></audio>
      <audio id="sfx-riser" class="clip" data-start="60.0" data-duration="1.2" data-track-index="29" data-volume="0.35" src="sound-effects/sci-fi-weapon-projectile-flyby-plasma-03-233857.mp3"></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      gsap.registerPlugin(CustomEase);
      CustomEase.create("brand", "M0,0 C0.16,0 0.18,1 1,1");
      const tl = gsap.timeline({ paused: true });

      tl.to("#studio", { x: 120, y: 60, scale: 1.12, duration: 34, ease: "sine.inOut", yoyo: true, repeat: 1 }, 0);
      tl.to("#floor", { opacity: 0.6, duration: 8, ease: "sine.inOut", yoyo: true, repeat: 8 }, 0);
      tl.to("#grain rect", { attr: { x: 8 }, duration: 0.25, ease: "none", repeat: 272, yoyo: true }, 0);

      function go(prev, next, ws, fromX) {
        const s = ws - 0.18;
        tl.to(prev, { opacity: 0, duration: 0.3, ease: "power2.inOut" }, s);
        tl.set(next, { opacity: 1 }, s);
        tl.fromTo(next, { xPercent: (fromX || 6), scale: 1.025 }, { xPercent: 0, scale: 1, duration: 0.46, ease: "power3.out" }, s);
      }
      function drift(sel, ws, dur) { tl.fromTo(sel + " .scene-inner", { scale: 1.0 }, { scale: 1.03, duration: dur, ease: "none" }, ws); }
      function countUp(sel, to, t, dur) {
        const o = { v: 0 };
        tl.to(o, { v: to, duration: dur, ease: "power2.out", onUpdate() { const e = document.querySelector(sel); if (e) e.textContent = Math.round(o.v); } }, t);
      }

      /* S1 (0-6.9) */
      drift("#s1", 0, 6.9);
      tl.fromTo("#h1", { scale: 1.4, opacity: 0, y: 18 }, { scale: 1, opacity: 1, y: 0, duration: 0.32, ease: "power3.out" }, 0.3);
      tl.fromTo("#h2", { scale: 1.4, opacity: 0, y: 18 }, { scale: 1, opacity: 1, y: 0, duration: 0.32, ease: "power3.out" }, 0.95);
      tl.fromTo("#h3", { scale: 1.4, opacity: 0, y: 18 }, { scale: 1, opacity: 1, y: 0, duration: 0.32, ease: "power3.out" }, 1.6);
      tl.from("#hfast", { y: 22, opacity: 0, duration: 0.5, ease: "power2.out" }, 2.4);

      /* S2 (6.9-11.8) */
      go("#s1", "#s2", 6.9, 0);
      drift("#s2", 6.9, 4.9);
      tl.fromTo("#s2-badge", { scale: 0.5, opacity: 0, rotation: -6 }, { scale: 1, opacity: 1, rotation: 0, duration: 0.8, ease: "back.out(1.8)" }, 6.95);
      tl.fromTo("#s2-glow", { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.9, ease: "power2.out" }, 6.95);
      tl.to("#s2-glow", { scale: 1.14, duration: 1.7, ease: "sine.inOut", yoyo: true, repeat: 1 }, 8.0);
      tl.fromTo("#s2-sheen", { x: -240 }, { x: 560, duration: 0.9, ease: "power2.inOut" }, 7.65);
      tl.from("#s2-wm", { y: 42, opacity: 0, duration: 0.6, ease: "brand" }, 7.6);
      tl.from("#s2-tag", { y: 18, opacity: 0, duration: 0.5, ease: "power2.out" }, 8.0);

      /* S3 3D ring (11.8-23.6) synced to VO labels */
      go("#s2", "#s3", 11.8, 6);
      tl.from("#car-eye", { y: 14, opacity: 0, duration: 0.4, ease: "power2.out" }, 11.7);
      tl.from("#car-title", { y: 22, opacity: 0, duration: 0.5, ease: "power3.out" }, 11.85);
      tl.fromTo("#ring3d", { opacity: 0, scale: 0.86 }, { opacity: 1, scale: 1, duration: 0.45, ease: "power3.out" }, 12.2);
      const FOC = { scale: 1.08, filter: "blur(0px) brightness(1)" };
      const BLR = { scale: 0.9, filter: "blur(4px) brightness(0.5)" };
      tl.set("#ph1", FOC, 12.2);
      tl.to(".scover", { opacity: 0, duration: 0.4, stagger: 0.04, ease: "power2.out" }, 13.0);
      tl.fromTo("#cap1", { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 }, 13.0);
      const stepT = [13.4, 14.7, 16.2, 17.8, 19.5];
      for (let k = 0; k < 5; k++) {
        const t = stepT[k], front = k + 2, prev = k + 1;
        tl.to("#ring3d", { rotationY: -60 * (k + 1), duration: 0.62, ease: "power2.inOut" }, t - 0.12);
        tl.to("#ph" + prev, BLR, t - 0.12);
        tl.to("#ph" + front, FOC, t + 0.1);
        tl.to("#cap" + prev, { y: -10, opacity: 0, duration: 0.3, ease: "power2.in" }, t - 0.18);
        tl.fromTo("#cap" + front, { y: 12, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 }, t);
      }
      tl.to("#ring3d", { y: -12, duration: 1.9, yoyo: true, repeat: 1, ease: "sine.inOut" }, 20.0);

      /* SI industries + references (23.6-32.2) synced to VO */
      go("#s3", "#si", 23.6, 6);
      tl.from("#si .s-corner", { y: -12, opacity: 0, duration: 0.4, ease: "power2.out" }, 23.7);
      tl.from("#si-eye", { y: 14, opacity: 0, duration: 0.4, ease: "power2.out" }, 23.7);
      tl.from("#si-head", { y: 24, opacity: 0, duration: 0.5, ease: "power3.out" }, 23.9);
      const indT = [24.65, 25.54, 26.2, 27.0, 28.08];
      for (let i = 0; i < 5; i++) {
        tl.fromTo("#ind" + (i + 1), { scale: 0.5, opacity: 0, y: 14 }, { scale: 1, opacity: 1, y: 0, duration: 0.4, ease: "back.out(2)" }, indT[i]);
        tl.to("#ind" + (i + 1), { className: "ind on", duration: 0.01 }, indT[i] + 0.2);
      }
      tl.from("#trust-label", { opacity: 0, y: 12, duration: 0.4, ease: "power2.out" }, 29.0);
      tl.from(".cl", { opacity: 0, y: 22, scale: 0.82, duration: 0.5, stagger: 0.1, ease: "back.out(1.5)" }, 29.3);
      tl.to("#logo-wall", { y: -8, duration: 2.2, yoyo: true, repeat: 1, ease: "sine.inOut" }, 30.4);

      /* S4 expanding models (32.2-39.6) */
      go("#si", "#s4", 32.2, 6);
      drift("#s4", 32.2, 7.4);
      tl.from("#s4 .s-corner", { y: -12, opacity: 0, duration: 0.4, ease: "power2.out" }, 32.3);
      tl.from("#s4-eye", { y: 14, opacity: 0, duration: 0.4, ease: "power2.out" }, 32.2);
      tl.from("#s4-head", { y: 24, opacity: 0, duration: 0.5, ease: "power3.out" }, 32.35);
      tl.from("#mc1", { y: 56, opacity: 0, duration: 0.5, ease: "back.out(1.4)" }, 32.7);
      tl.from("#mc2", { y: 56, opacity: 0, duration: 0.5, ease: "back.out(1.4)" }, 32.95);
      tl.to("#md1", { height: 232, duration: 0.5, ease: "power3.out" }, 33.5);
      tl.from("#md1 .mrow", { x: -18, opacity: 0, duration: 0.35, stagger: 0.08, ease: "power2.out" }, 33.6);
      tl.from("#md1 .mprice", { opacity: 0, duration: 0.3 }, 34.0);
      tl.fromTo("#mc1", { scale: 1.0 }, { scale: 1.015, duration: 0.4, yoyo: true, repeat: 1, ease: "sine.inOut" }, 33.5);
      tl.to("#md2", { height: 232, duration: 0.5, ease: "power3.out" }, 34.7);
      tl.from("#md2 .mrow", { x: -18, opacity: 0, duration: 0.35, stagger: 0.08, ease: "power2.out" }, 34.8);
      tl.from("#md2 .mprice", { opacity: 0, duration: 0.3 }, 35.2);
      tl.fromTo("#mc2", { scale: 1.0 }, { scale: 1.015, duration: 0.4, yoyo: true, repeat: 1, ease: "sine.inOut" }, 34.7);
      tl.from("#s4-foot", { y: 14, opacity: 0, duration: 0.45, ease: "power2.out" }, 35.9);

      /* S5 engine foreground (39.6-54.0) synced to VO cues */
      go("#s4", "#s5", 39.6, 6);
      tl.from("#s5 .s-corner", { y: -12, opacity: 0, duration: 0.4, ease: "power2.out" }, 39.7);
      tl.from("#eng-eye", { y: 14, opacity: 0, duration: 0.4, ease: "power2.out" }, 39.6);
      tl.from("#eng-title", { y: 22, opacity: 0, duration: 0.45, ease: "power3.out" }, 39.75);
      tl.from(".eseg, .arr2", { opacity: 0, y: 10, duration: 0.4, stagger: 0.04, ease: "power2.out" }, 40.0);
      const efT = [40.0, 41.9, 43.6, 46.1, 48.0];
      const segEnd = [41.9, 43.6, 46.1, 48.0, 53.7];
      const cardIn = { opacity: 1, scale: 1, y: 0, filter: "blur(0px)" };
      for (let k = 0; k < 5; k++) {
        const id = "#ef" + (k + 1), t = efT[k];
        tl.fromTo(id, { opacity: 0, scale: 0.82, y: 36, filter: "blur(8px)" }, { ...cardIn, duration: 0.42, ease: "back.out(1.5)" }, t);
        if (k > 0) tl.to("#ef" + k, { opacity: 0, scale: 1.12, filter: "blur(7px)", duration: 0.34, ease: "power2.in" }, t - 0.02);
        tl.fromTo("#seg" + (k + 1) + " i", { scaleX: 0 }, { scaleX: 1, duration: (segEnd[k] - t), ease: "none" }, t);
        if (k > 0) tl.to("#seg" + k + " i", { opacity: 0.45, duration: 0.3 }, t);
      }
      tl.from("#lg-ig", { scale: 0.4, opacity: 0, duration: 0.4, ease: "back.out(2)" }, 48.5);
      tl.from("#lg-tt", { scale: 0.4, opacity: 0, duration: 0.4, ease: "back.out(2)" }, 48.7);
      tl.from("#lg-yt", { scale: 0.4, opacity: 0, duration: 0.4, ease: "back.out(2)" }, 48.9);
      tl.from("#eng-foot", { opacity: 0, y: 12, duration: 0.45, ease: "power2.out" }, 50.4);

      /* S6 numbers (54.0-60.8) */
      go("#s5", "#s6", 54.0, 6);
      drift("#s6", 54.0, 6.8);
      tl.from("#s6 .s-corner", { y: -12, opacity: 0, duration: 0.4, ease: "power2.out" }, 54.1);
      tl.from("#s6-eye", { y: 14, opacity: 0, duration: 0.4, ease: "power2.out" }, 54.0);
      tl.from("#s6-head", { y: 24, opacity: 0, duration: 0.5, ease: "power3.out" }, 54.15);
      tl.from(".s6s", { y: 64, opacity: 0, scale: 0.9, duration: 0.5, stagger: 0.12, ease: "back.out(1.4)" }, 54.4);
      countUp("#n1", 10, 54.6, 1.0);
      countUp("#n2", 80, 54.8, 1.1);
      tl.fromTo("#n3", { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(2)" }, 55.1);
      tl.from("#s6-foot", { y: 16, opacity: 0, duration: 0.45, ease: "power2.out" }, 55.8);

      /* S7 CTA (60.8-68.1) */
      go("#s6", "#s7", 60.8, 6);
      tl.from("#s7-kick", { y: 16, opacity: 0, duration: 0.45, ease: "power2.out" }, 60.9);
      tl.from("#s7-head", { y: 42, opacity: 0, scale: 0.97, duration: 0.68, ease: "back.out(1.4)" }, 61.0);
      tl.from("#s7-contact", { y: 18, opacity: 0, duration: 0.55, ease: "power2.out" }, 61.7);
      tl.fromTo("#s7-btn", { y: 26, opacity: 0, scale: 0.9 }, { y: 0, opacity: 1, scale: 1, duration: 0.62, ease: "back.out(1.8)" }, 62.1);
      tl.to("#s7-btn", { scale: 1.05, duration: 0.8, ease: "sine.inOut", yoyo: true, repeat: 4 }, 63.0);
      tl.to("#s7 .scene-inner", { opacity: 0, duration: 0.7, ease: "power2.in" }, 67.3);

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
