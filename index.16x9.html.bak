<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #0A0A0B; color: #F2F2F0;
        font-family: "Space Grotesk", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
      .mono { font-family: "Space Mono", monospace; }
      .sil { background: linear-gradient(120deg, #FFFFFF 0%, #C7C7CD 50%, #8C8C93 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .tnum { font-variant-numeric: tabular-nums; }

      #bgfx { position: absolute; inset: 0; z-index: 0; overflow: hidden; background: #0A0A0B; }
      #studio { position: absolute; width: 1700px; height: 1100px; left: 50%; top: -380px; transform: translateX(-50%);
        background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0) 70%); }
      #floor { position: absolute; left: 0; right: 0; bottom: -300px; height: 700px;
        background: radial-gradient(ellipse 60% 60% at 50% 100%, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0) 70%); }
      .grain-svg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.05; mix-blend-mode: overlay; pointer-events: none; }
      #vignette { position: absolute; inset: 0; background: radial-gradient(ellipse 92% 86% at 50% 46%, rgba(10,10,11,0) 38%, rgba(4,4,5,0.86) 100%); }

      .scene { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; justify-content: center; padding: 0 150px; opacity: 0; }
      #s1 { opacity: 1; }
      .scene-inner { position: relative; z-index: 3; width: 100%; }
      .eyebrow { font-family: "Space Mono", monospace; font-size: 22px; font-weight: 700; letter-spacing: 0.38em; text-transform: uppercase; color: #9C9CA1; }
      .corner { position: absolute; top: 58px; left: 150px; z-index: 5; display: flex; align-items: center; gap: 14px; }
      .corner .chip { width: 56px; height: 56px; border-radius: 14px; background: #F2F2F0; display: grid; place-items: center; overflow: hidden;
        box-shadow: 0 0 0 1px rgba(255,255,255,0.12), 0 10px 26px rgba(0,0,0,0.5); }
      .corner .chip img { width: 80%; }
      .corner .wm { font-size: 27px; font-weight: 700; letter-spacing: -0.02em; }

      /* S1 hook */
      #s1 { justify-content: center; }
      .s1-stack { display: flex; flex-direction: column; gap: 4px; }
      .s1-line { font-size: 152px; font-weight: 700; line-height: 0.92; letter-spacing: -0.045em; color: #F2F2F0; }
      .s1-fast { margin-top: 26px; font-size: 60px; font-weight: 400; color: #9C9CA1; letter-spacing: -0.01em; }
      .s1-fast b { color: #F2F2F0; font-weight: 600; }

      /* S2 brand */
      #s2 { align-items: center; text-align: center; }
      .badge-wrap { position: relative; display: grid; place-items: center; margin-bottom: 44px; }
      .badge-glow { position: absolute; width: 460px; height: 460px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0) 64%); filter: blur(10px); }
      .logo-badge { position: relative; width: 270px; height: 270px; border-radius: 52px; background: #F2F2F0; display: grid; place-items: center; overflow: hidden;
        box-shadow: 0 0 0 1px rgba(255,255,255,0.14), 0 40px 90px rgba(0,0,0,0.6); }
      .logo-badge img { width: 78%; }
      .logo-badge .sheen { position: absolute; top: -20%; left: -60%; width: 50%; height: 140%; background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.85) 50%, rgba(255,255,255,0) 100%); transform: skewX(-18deg); }
      .wordmark { font-size: 138px; font-weight: 700; letter-spacing: -0.045em; line-height: 1; }
      .wordmark .llc { font-family: "Space Mono", monospace; font-size: 36px; font-weight: 700; vertical-align: super; color: #6A6A70; letter-spacing: 0; margin-left: 10px; }
      .s2-tag { font-family: "Space Mono", monospace; font-size: 24px; font-weight: 700; letter-spacing: 0.44em; text-transform: uppercase; color: #9C9CA1; margin-top: 26px; }

      /* S3 3D ring */
      #s3 { justify-content: center; }
      .car-top { text-align: center; margin-bottom: 14px; }
      .car-title { font-size: 50px; font-weight: 700; letter-spacing: -0.03em; margin-top: 8px; }
      .carrail { position: relative; height: 700px; width: 100%; perspective: 1700px; perspective-origin: 50% 44%; }
      .ring3d { position: absolute; left: 50%; top: 30px; width: 0; height: 632px; transform-style: preserve-3d; opacity: 0; }
      .phone-pos { position: absolute; left: -151px; top: 0; width: 302px; height: 632px; transform-style: preserve-3d; backface-visibility: hidden; }
      .phone { position: relative; width: 302px; height: 632px; border-radius: 52px; background: linear-gradient(155deg, #46464b 0%, #1a1a1d 38%, #0c0c0e 100%); padding: 11px;
        box-shadow: 0 40px 90px rgba(0,0,0,0.7), inset 0 0 2px rgba(255,255,255,0.35); transform: scale(0.9); filter: blur(4px) brightness(0.5); }
      .phone .screen { position: relative; width: 100%; height: 100%; border-radius: 43px; overflow: hidden; background: #000; }
      .phone .screen video { width: 100%; height: 100%; object-fit: cover; }
      .phone .island { position: absolute; top: 13px; left: 50%; transform: translateX(-50%); width: 90px; height: 26px; background: #000; border-radius: 14px; z-index: 3; }
      .phone .glass { position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(120deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 28%); }
      .phone .scover { position: absolute; inset: 0; z-index: 4; background: #050506; }
      .ccap-bar { position: relative; height: 50px; margin-top: 6px; }
      .ccap { position: absolute; left: 0; right: 0; text-align: center; opacity: 0; }
      .ccap .ct { font-size: 32px; font-weight: 700; letter-spacing: -0.02em; }
      .ccap .cs { font-family: "Space Mono", monospace; font-size: 21px; color: #9C9CA1; letter-spacing: 0.16em; text-transform: uppercase; margin-left: 14px; }

      /* SI industries + references */
      #si { align-items: center; text-align: center; }
      .si-head { font-size: 60px; font-weight: 700; letter-spacing: -0.03em; margin: 12px 0 44px; }
      .ind-row { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
      .ind { font-family: "Space Mono", monospace; font-size: 28px; font-weight: 700; letter-spacing: 0.02em; color: #E2E2E4;
        background: #161618; border: 1px solid #2C2C30; padding: 16px 30px; border-radius: 999px; }
      .ind.on { border-color: #5A5A62; background: #1C1C20; }
      .trust-label { font-family: "Space Mono", monospace; font-size: 20px; font-weight: 700; letter-spacing: 0.32em; text-transform: uppercase; color: #8B8B91; margin-top: 64px; }
      .logo-wall { display: flex; gap: 64px; justify-content: center; align-items: center; margin-top: 34px; }
      .clogo { height: 62px; display: grid; place-items: center; }
      .clogo img { height: 100%; width: auto; max-width: 260px; object-fit: contain; opacity: 0.82; }

      /* S4 expanding models */
      #s4 { justify-content: center; }
      .s4-head { font-size: 60px; font-weight: 700; letter-spacing: -0.03em; margin: 12px 0 34px; }
      .model-row { display: flex; gap: 34px; align-items: flex-start; }
      .mcard { position: relative; flex: 1; padding: 38px 42px; border-radius: 26px; background: #161618; border: 1px solid #2C2C30; overflow: hidden; }
      .mcard.hero { border-color: #4A4A50; background: #1A1A1D; }
      .mcard .mtag { font-family: "Space Mono", monospace; font-size: 21px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #9C9CA1; }
      .mcard .mtitle { font-size: 48px; font-weight: 700; letter-spacing: -0.03em; margin: 12px 0 14px; }
      .mcard .mdesc { font-size: 26px; color: #B9B9BE; font-weight: 400; line-height: 1.4; }
      .mdetails { overflow: hidden; height: 0; }
      .mdetails .mrow { display: flex; align-items: center; gap: 14px; margin-top: 18px; font-size: 23px; color: #E2E2E4; }
      .mdetails .mrow .dot { width: 9px; height: 9px; border-radius: 50%; background: #F2F2F0; flex: none; }
      .mdetails .mprice { font-family: "Space Mono", monospace; font-size: 26px; color: #F2F2F0; margin-top: 22px; font-weight: 700; }
      .s4-foot { margin-top: 30px; text-align: center; font-size: 30px; color: #B9B9BE; }
      .s4-foot .sil { font-weight: 700; }

      /* S5 engine foreground */
      #s5 { justify-content: center; }
      .eng-top { text-align: center; margin-bottom: 22px; }
      .eng-title { font-size: 52px; font-weight: 700; letter-spacing: -0.03em; margin-top: 6px; }
      .estage { position: relative; height: 470px; }
      .efc { position: absolute; left: 50%; top: 0; width: 1240px; transform: translateX(-50%); padding: 44px 56px; border-radius: 30px; background: #161618; border: 1px solid #34343A; opacity: 0;
        box-shadow: 0 50px 110px rgba(0,0,0,0.6); display: flex; gap: 48px; align-items: center; }
      .efc .enum { width: 128px; height: 128px; border-radius: 28px; background: #F2F2F0; color: #0A0A0B; flex: none; display: grid; place-items: center; font-family: "Space Mono", monospace; font-weight: 700; font-size: 56px; }
      .efc .ebody { flex: 1; }
      .efc .et { font-size: 46px; font-weight: 700; letter-spacing: -0.02em; }
      .efc .echips { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
      .efc .chip { font-family: "Space Mono", monospace; font-size: 21px; color: #D7D7DB; background: #232327; border: 1px solid #3A3A40; padding: 12px 18px; border-radius: 999px; letter-spacing: 0.02em; }
      .slogos { display: flex; gap: 20px; margin-top: 22px; align-items: center; }
      .slogo { display: flex; align-items: center; gap: 12px; background: #232327; border: 1px solid #3A3A40; padding: 12px 22px 12px 16px; border-radius: 16px; }
      .slogo svg { display: block; }
      .slogo span { font-family: "Space Mono", monospace; font-size: 20px; color: #E2E2E4; font-weight: 700; }
      .erail { display: flex; gap: 10px; justify-content: center; margin-top: 28px; }
      .eseg { display: flex; align-items: center; gap: 10px; }
      .eseg .seg { width: 132px; height: 5px; border-radius: 3px; background: #2C2C30; overflow: hidden; }
      .eseg .seg i { display: block; height: 100%; width: 100%; background: #F2F2F0; transform: scaleX(0); transform-origin: left; }
      .eseg .sl { font-family: "Space Mono", monospace; font-size: 16px; color: #6A6A70; letter-spacing: 0.1em; text-transform: uppercase; }
      .eseg .arr2 { color: #4A4A50; font-size: 16px; }
      .eng-foot { margin-top: 22px; text-align: center; font-family: "Space Mono", monospace; font-size: 22px; letter-spacing: 0.14em; text-transform: uppercase; color: #9C9CA1; }
      .eng-foot b { color: #F2F2F0; }

      /* S6 numbers */
      #s6 { justify-content: center; }
      .s6-head { font-size: 62px; font-weight: 700; letter-spacing: -0.03em; margin: 12px 0 50px; }
      .stat-row { display: flex; gap: 34px; }
      .stat { flex: 1; padding: 44px 40px; border-radius: 24px; background: #161618; border: 1px solid #2C2C30; }
      .stat .v { font-family: "Space Mono", monospace; font-weight: 700; font-size: 138px; line-height: 0.9; letter-spacing: -0.04em; }
      .stat .k { font-size: 26px; font-weight: 700; color: #F2F2F0; margin-top: 20px; text-transform: uppercase; letter-spacing: 0.03em; }
      .stat .d { font-size: 22px; font-weight: 400; color: #9C9CA1; margin-top: 10px; }
      .s6-foot { margin-top: 42px; font-family: "Space Mono", monospace; font-size: 26px; letter-spacing: 0.14em; text-transform: uppercase; color: #9C9CA1; }
      .s6-foot b { color: #F2F2F0; }

      /* S7 CTA */
      #s7 { align-items: center; text-align: center; }
      .s7-kick { font-family: "Space Mono", monospace; font-size: 26px; letter-spacing: 0.2em; text-transform: uppercase; color: #9C9CA1; margin-bottom: 24px; }
      .s7-head { font-size: 118px; font-weight: 700; letter-spacing: -0.045em; line-height: 0.98; }
      .s7-contact { display: flex; gap: 30px; align-items: center; margin-top: 44px; font-family: "Space Mono", monospace; font-size: 27px; color: #E2E2E4; }
      .s7-contact .dotsep { color: #6A6A70; }
      .cta-btn { margin-top: 48px; display: inline-flex; align-items: center; gap: 16px; font-size: 37px; font-weight: 700; color: #0A0A0B; background: #F2F2F0; padding: 25px 54px; border-radius: 999px; box-shadow: 0 24px 60px rgba(0,0,0,0.5); }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="68.1" data-width="1920" data-height="1080">

      <div id="bgfx">
        <div id="studio" data-layout-ignore></div>
        <div id="floor" data-layout-ignore></div>
        <svg class="grain-svg" id="grain" data-layout-ignore><filter id="gr"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#gr)"/></svg>
        <div id="vignette"></div>
      </div>

      <!-- S1 hook -->
      <div id="s1" class="scene">
        <div class="scene-inner">
          <div class="s1-stack">
            <div class="s1-line" id="h1">MORE ADS.</div>
            <div class="s1-line" id="h2">MORE <span class="sil">TESTS.</span></div>
            <div class="s1-line" id="h3">MORE WINS.</div>
          </div>
          <div class="s1-fast" id="hfast">and your team needs them <b>fast.</b></div>
        </div>
      </div>

      <!-- S2 brand -->
      <div id="s2" class="scene">
        <div class="scene-inner" style="display:flex;flex-direction:column;align-items:center;">
          <div class="badge-wrap">
            <div class="badge-glow" id="s2-glow" data-layout-ignore></div>
            <div class="logo-badge" id="s2-badge"><img src="assets/logos/logo-kocka.png" alt="3DM" /><div class="sheen" id="s2-sheen" data-layout-ignore></div></div>
          </div>
          <div class="wordmark" id="s2-wm">3<span class="sil">DM</span><span class="llc">LLC</span></div>
          <div class="s2-tag" id="s2-tag">AI Video Production Studio</div>
        </div>
      </div>

      <!-- S3 3D ring carousel -->
      <div id="s3" class="scene">
        <div class="corner s-corner"><div class="chip"><img src="assets/logos/logo-kocka.png" alt="3DM"/></div><div class="wm">3<span class="sil">DM</span></div></div>
        <div class="scene-inner">
          <div class="car-top">
            <div class="eyebrow" id="car-eye">Selected work</div>
            <div class="car-title" id="car-title">Ads that <span class="sil">stop the scroll.</span></div>
          </div>
          <div class="carrail">
            <div class="ring3d" id="ring3d">
              <div class="phone-pos" style="transform:rotateY(0deg) translateZ(380px)"><div class="phone" id="ph1"><div class="screen"><video id="c1" class="clip" data-start="11.0" data-duration="13.7" data-track-index="0" src="assets/videos/prod-fashion.mp4" muted playsinline></video><div class="island"></div><div class="glass"></div><div class="scover"></div></div></div></div>
              <div class="phone-pos" style="transform:rotateY(60deg) translateZ(380px)"><div class="phone" id="ph2"><div class="screen"><video id="c2" class="clip" data-start="11.0" data-duration="13.7" data-media-start="6" data-track-index="1" src="assets/videos/prod-phone.mp4" muted playsinline></video><div class="island"></div><div class="glass"></div><div class="scover"></div></div></div></div>
              <div class="phone-pos" style="transform:rotateY(120deg) translateZ(380px)"><div class="phone" id="ph3"><div class="screen"><video id="c3" class="clip" data-start="11.0" data-duration="13.7" data-track-index="2" src="assets/videos/prod-watch.mp4" muted playsinline></video><div class="island"></div><div class="glass"></div><div class="scover"></div></div></div></div>
              <div class="phone-pos" style="transform:rotateY(180deg) translateZ(380px)"><div class="phone" id="ph4"><div class="screen"><video id="c4" class="clip" data-start="11.0" data-duration="13.7" data-track-index="3" src="assets/videos/prod-unbox.mp4" muted playsinline></video><div class="island"></div><div class="glass"></div><div class="scover"></div></div></div></div>
              <div class="phone-pos" style="transform:rotateY(240deg) translateZ(380px)"><div class="phone" id="ph5"><div class="screen"><video id="c5" class="clip" data-start="11.0" data-duration="13.7" data-track-index="4" src="assets/videos/motion-app.mp4" muted playsinline></video><div class="island"></div><div class="glass"></div><div class="scover"></div></div></div></div>
              <div class="phone-pos" style="transform:rotateY(300deg) translateZ(380px)"><div class="phone" id="ph6"><div class="screen"><video id="c6" class="clip" data-start="11.0" data-duration="13.7" data-track-index="5" src="assets/videos/motion-compound.mp4" muted playsinline></video><div class="island"></div><div class="glass"></div><div class="scover"></div></div></div></div>
            </div>
          </div>
          <div class="ccap-bar">
            <div class="ccap" id="cap1"><span class="ct">Apparel</span><span class="cs">Fashion Ad</span></div>
            <div class="ccap" id="cap2"><span class="ct">Product Launch</span><span class="cs">Film</span></div>
            <div class="ccap" id="cap3"><span class="ct">Product Reveal</span><span class="cs">Video</span></div>
            <div class="ccap" id="cap4"><span class="ct">Unboxing</span><span class="cs">Social Ad</span></div>
            <div class="ccap" id="cap5"><span class="ct">App</span><span class="cs">Explainer</span></div>
            <div class="ccap" id="cap6"><span class="ct">Educational</span><span class="cs">Series</span></div>
          </div>
        </div>
      </div>

      <!-- SI industries + references -->
      <div id="si" class="scene">
        <div class="corner s-corner"><div class="chip"><img src="assets/logos/logo-kocka.png" alt="3DM"/></div><div class="wm">3<span class="sil">DM</span></div></div>
        <div class="scene-inner" style="display:flex;flex-direction:column;align-items:center;">
          <div class="eyebrow" id="si-eye">Industries we power</div>
          <div class="si-head" id="si-head">Built for <span class="sil">every vertical.</span></div>
          <div class="ind-row">
            <span class="ind" id="ind1">E-commerce</span>
            <span class="ind" id="ind2">Trading</span>
            <span class="ind" id="ind3">Finance</span>
            <span class="ind" id="ind4">Education</span>
            <span class="ind" id="ind5">Tech</span>
          </div>
          <div class="trust-label" id="trust-label">Trusted by</div>
          <div class="logo-wall" id="logo-wall">
            <div class="clogo cl"><img src="assets/logos/clients/astral.png" alt="Astral"/></div>
            <div class="clogo cl"><img src="assets/logos/clients/bloom.png" alt="Bloom"/></div>
            <div class="clogo cl"><img src="assets/logos/clients/emergent.png" alt="Emergent"/></div>
            <div class="clogo cl"><img src="assets/logos/clients/jetbrains.png" alt="JetBrains"/></div>
            <div class="clogo cl"><img src="assets/logos/clients/cloudways.png" alt="Cloudways"/></div>
          </div>
        </div>
      </div>

      <!-- S4 expanding models -->
      <div id="s4" class="scene">
        <div class="corner s-corner"><div class="chip"><img src="assets/logos/logo-kocka.png" alt="3DM"/></div><div class="wm">3<span class="sil">DM</span></div></div>
        <div class="scene-inner">
          <div class="eyebrow" id="s4-eye">Two ways to work with us</div>
          <div class="s4-head" id="s4-head">Your engine, <span class="sil">or your studio.</span></div>
          <div class="model-row">
            <div class="mcard hero m4" id="mc1">
              <div class="mtag">01 · Enablement · one-time</div>
              <div class="mtitle">AI Video <span class="sil">Engine</span></div>
              <div class="mdesc">Your own automated ad-creation engine.</div>
              <div class="mdetails" id="md1">
                <div class="mrow"><span class="dot"></span>Research, strategy and generation, automated</div>
                <div class="mrow"><span class="dot"></span>Runs end to end, hands-free</div>
                <div class="mrow"><span class="dot"></span>One-time setup, your team owns it</div>
                <div class="mprice">You <span class="sil">own it.</span></div>
              </div>
            </div>
            <div class="mcard m4" id="mc2">
              <div class="mtag">02 · Production · as a service</div>
              <div class="mtitle">Done <span class="sil">For You</span></div>
              <div class="mdesc">We produce your video ads, end to end.</div>
              <div class="mdetails" id="md2">
                <div class="mrow"><span class="dot"></span>Product, motion and social ads</div>
                <div class="mrow"><span class="dot"></span>Delivered in days, not weeks</div>
                <div class="mrow"><span class="dot"></span>Premium quality, on-brand every time</div>
                <div class="mprice">From <span class="sil">€10</span> / video.</div>
              </div>
            </div>
          </div>
          <div class="s4-foot" id="s4-foot">Two models. <span class="sil">One goal:</span> scale your video output.</div>
        </div>
      </div>

      <!-- S5 engine foreground -->
      <div id="s5" class="scene">
        <div class="corner s-corner"><div class="chip"><img src="assets/logos/logo-kocka.png" alt="3DM"/></div><div class="wm">3<span class="sil">DM</span></div></div>
        <div class="scene-inner">
          <div class="eng-top">
            <div class="eyebrow" id="eng-eye">Inside the AI video engine</div>
            <div class="eng-title" id="eng-title">From brief to publish, <span class="sil">on autopilot.</span></div>
          </div>
          <div class="estage">
            <div class="efc" id="ef1"><div class="enum">01</div><div class="ebody"><div class="et">Inputs &amp; Knowledge</div><div class="echips"><span class="chip">Brand &amp; tone of voice</span><span class="chip">Niche &amp; competitors</span><span class="chip">Top-performing ads</span><span class="chip">Product &amp; assets</span></div></div></div>
