<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/CustomEase.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/SplitText.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/ScrambleTextPlugin.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #050505; color: #F6F7F8;
        font-family: "Geist", "Inter", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
      .mono { font-family: "Geist Mono", "IBM Plex Mono", monospace; }
      .blue { color: #6E86FF; }
      .tnum { font-variant-numeric: tabular-nums; }

      /* ---------- background system ---------- */
      #bgfx { position: absolute; inset: 0; z-index: 0; overflow: hidden; background: #050505; }
      #fx { position: absolute; inset: 0; z-index: 1; }
      .glow { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(12px); }
      #glow-a { width: 1300px; height: 1300px; left: -320px; top: -420px;
        background: radial-gradient(circle, rgba(77,107,255,0.20) 0%, rgba(77,107,255,0) 62%); }
      #glow-b { width: 1500px; height: 1500px; right: -420px; bottom: -520px;
        background: radial-gradient(circle, rgba(45,63,153,0.22) 0%, rgba(45,63,153,0) 64%); }
      #glow-c { width: 900px; height: 900px; left: 50%; top: 44%; transform: translate(-50%,-50%);
        background: radial-gradient(circle, rgba(110,134,255,0.10) 0%, rgba(110,134,255,0) 60%); }
      .grain-svg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.045; mix-blend-mode: overlay; pointer-events: none; z-index: 2; }
      #vignette { position: absolute; inset: 0; z-index: 2;
        background: radial-gradient(ellipse 88% 84% at 50% 46%, rgba(5,5,5,0) 40%, rgba(0,0,0,0.9) 100%); }
      #gridbg { position: absolute; inset: 0; z-index: 0; opacity: 0;
        background-image: linear-gradient(rgba(140,160,255,0.05) 1px, rgba(5,5,5,0) 1px), linear-gradient(90deg, rgba(140,160,255,0.05) 1px, rgba(5,5,5,0) 1px);
        background-size: 90px 90px; }

      /* ---------- scenes ---------- */
      .scene { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; justify-content: center; padding: 0 160px; opacity: 0; }
      #s1 { opacity: 1; }
      .scene-inner { position: relative; width: 100%; }
      .mask { overflow: visible; }
      .mask > .in { display: block; }
      .eyebrow { font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 21px; letter-spacing: 0.34em; text-transform: uppercase; color: #8A8E99; }

      /* ---------- captions ---------- */
      #capbar { position: absolute; left: 0; right: 0; bottom: 56px; z-index: 8; display: flex; justify-content: center; pointer-events: none; }
      #capline { max-width: 980px; padding: 12px 26px; border-radius: 12px; background: rgba(5,5,5,0.55);
        font-size: 25px; font-weight: 400; color: #F6F7F8; letter-spacing: 0.01em; text-align: center; opacity: 0; }

      /* S1 hook */
      #s1 { justify-content: center; }
      .s1-head { font-weight: 600; letter-spacing: -0.04em; line-height: 1.1; color: #F6F7F8; }
      .s1-head .in { font-size: 118px; }
      #s1b { margin-top: 34px; }
      #s1b .in { font-size: 150px; font-weight: 700; letter-spacing: -0.045em; }
      .s1-eye { margin-bottom: 40px; }
      .sys-underline { display: inline-block; position: relative; }
      .sys-underline .ul { position: absolute; left: 0; right: 0; bottom: -0.1em; height: 5px; background: #4D6BFF; transform: scaleX(0); transform-origin: left; box-shadow: 0 0 24px rgba(77,107,255,0.85); }

      /* S2 brand reveal */
      #s2 { align-items: center; text-align: center; }
      .logo-hero { position: relative; display: grid; place-items: center; margin-bottom: 46px; }
      .logo-hero img { width: 260px; filter: drop-shadow(0 24px 60px rgba(77,107,255,0.35)); }
      .logo-hero .lglow { position: absolute; width: 520px; height: 520px; border-radius: 50%;
        background: radial-gradient(circle, rgba(77,107,255,0.28) 0%, rgba(77,107,255,0) 62%); filter: blur(8px); z-index: -1; }
      .sheenwrap { position: absolute; width: 260px; height: 268px; overflow: hidden;
        -webkit-mask-image: url("assets/logos/logo-white.png"); mask-image: url("assets/logos/logo-white.png");
        -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center; }
      .sheenwrap .sheen { position: absolute; top: -10%; left: 0; width: 40%; height: 130%;
        background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.65) 50%, rgba(255,255,255,0) 100%); transform: skewX(-16deg); }
      .s2-wm { font-size: 118px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
      .s2-label { font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 27px; font-weight: 500; letter-spacing: 0.4em; text-transform: uppercase; color: #8A8E99; margin-top: 24px; }
      .s2-sub { font-size: 34px; font-weight: 400; color: #8A8E99; letter-spacing: 0.02em; margin-top: 30px; }
      .ribbon { margin-top: 54px; font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 24px; letter-spacing: 0.26em; text-transform: uppercase; color: #4D6BFF; white-space: nowrap; }
      .ribbon .dot { color: #2D3F99; margin: 0 18px; }

      /* S3 origin timeline */
      #s3 { justify-content: center; }
      .s3-head { font-size: 76px; font-weight: 700; letter-spacing: -0.04em; line-height: 1.04; margin: 18px 0 70px; }
      .tl-wrap { position: relative; height: 380px; }
      .tl-line { position: absolute; left: 0; right: 0; top: 190px; height: 2px; background: #23252B; }
      .tl-line i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, #4D6BFF 0%, #2D3F99 100%); transform: scaleX(0); transform-origin: left; box-shadow: 0 0 18px rgba(77,107,255,0.5); }
      .tl-node { position: absolute; width: 420px; }
      .tl-node .nd { position: absolute; left: 50%; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: #4D6BFF; box-shadow: 0 0 16px rgba(77,107,255,0.8); }
      .tl-node.top { top: 0; } .tl-node.top .nd { bottom: -47px; }
      .tl-node.bot { top: 238px; } .tl-node.bot .nd { top: -55px; }
      .tl-card { padding: 26px 30px; border-radius: 18px; background: rgba(16,17,20,0.88); border: 1px solid rgba(255,255,255,0.10); }
      .tl-card .yr { font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 21px; font-weight: 600; letter-spacing: 0.22em; color: #6E86FF; }
      .tl-card .tt { font-size: 30px; font-weight: 600; letter-spacing: -0.02em; margin-top: 10px; }
      .tl-card .td { font-size: 21px; font-weight: 400; color: #8A8E99; margin-top: 8px; line-height: 1.4; }
      .tl-tags { display: flex; gap: 42px; justify-content: center; margin-top: 54px;
        font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 19px; letter-spacing: 0.3em; text-transform: uppercase; color: #565A66; }

      /* S4 workflow */
      #s4 { justify-content: center; }
      .s4-head { font-size: 72px; font-weight: 700; letter-spacing: -0.04em; line-height: 1.05; margin: 18px 0 66px; }
      .flow { display: flex; align-items: center; gap: 0; }
      .fnode { flex: 1; padding: 30px 20px; border-radius: 18px; background: rgba(16,17,20,0.88); border: 1px solid rgba(255,255,255,0.10); text-align: center; }
      .fnode .fi { font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 18px; letter-spacing: 0.2em; color: #6E86FF; }
      .fnode .ft { font-size: 26px; font-weight: 600; letter-spacing: -0.01em; margin-top: 10px; }
      .fcon { width: 74px; height: 2px; background: #23252B; position: relative; flex: none; }
      .fcon i { display: block; height: 100%; width: 100%; background: #4D6BFF; transform: scaleX(0); transform-origin: left; box-shadow: 0 0 12px rgba(77,107,255,0.6); }
      .pulses { display: flex; gap: 22px; margin-top: 56px; justify-content: center; }
      .pulse { display: flex; align-items: center; gap: 12px; padding: 14px 26px; border-radius: 999px;
        background: rgba(16,17,20,0.88); border: 1px solid rgba(255,255,255,0.10);
        font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 20px; letter-spacing: 0.16em; text-transform: uppercase; color: #C9CCD4; }
      .pulse .pd { width: 9px; height: 9px; border-radius: 50%; background: #4D6BFF; box-shadow: 0 0 12px rgba(77,107,255,0.9); }

      /* S5 ecosystem - big product videos */
      #s5 { justify-content: center; padding: 0 110px; }
      .s5-head { font-size: 58px; font-weight: 700; letter-spacing: -0.04em; line-height: 1.06; margin: 12px 0 30px; }
      .pstage { position: relative; width: 100%; height: 600px; }
      .pcard { position: absolute; inset: 0; border-radius: 26px; background: linear-gradient(160deg, #17181C 0%, #101114 100%);
        border: 1px solid rgba(255,255,255,0.12); opacity: 0; overflow: hidden;
        box-shadow: 0 40px 90px rgba(0,0,0,0.6); display: flex; }
      .pcard .pmeta { width: 460px; flex: none; padding: 52px 48px; display: flex; flex-direction: column; justify-content: center; }
      .pcard .ptag { align-self: flex-start; font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 18px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: #6E86FF;
        border: 1px solid rgba(110,134,255,0.35); border-radius: 999px; padding: 8px 18px; }
      .pcard .pname { font-size: 58px; font-weight: 700; letter-spacing: -0.03em; margin-top: 26px; }
      .pcard .pdesc { font-size: 25px; font-weight: 400; color: #A9ADB8; line-height: 1.45; margin-top: 18px; }
      .pcard .pvid { flex: 1; min-width: 0; background: #08090C; border-left: 1px solid rgba(255,255,255,0.08); position: relative; }
      .pcard .pvid video { width: 100%; height: 100%; object-fit: contain; }
      .ptabs { display: flex; gap: 12px; margin-top: 24px; }
      .ptab { flex: 1; padding: 14px 10px; border-radius: 12px; background: rgba(16,17,20,0.8); border: 1px solid rgba(255,255,255,0.08);
        font-size: 21px; font-weight: 500; color: #8A8E99; text-align: center; letter-spacing: 0.01em; }
      .ptab.on { color: #F6F7F8; border-color: rgba(110,134,255,0.5); background: rgba(23,24,28,0.95); }

      /* S6 services */
      #s6 { justify-content: center; }
      .s6-head { font-size: 62px; font-weight: 700; letter-spacing: -0.04em; margin: 14px 0 46px; }
      .svc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
      .svc { padding: 34px 38px; border-radius: 22px; background: rgba(16,17,20,0.88); border: 1px solid rgba(255,255,255,0.10); position: relative; overflow: hidden; }
      .svc .st { font-size: 34px; font-weight: 650; letter-spacing: -0.02em; }
      .svc .schips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
      .svc .sc { font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 17px; letter-spacing: 0.12em; text-transform: uppercase; color: #8A8E99;
        border: 1px solid rgba(255,255,255,0.10); border-radius: 999px; padding: 8px 16px; }
      .svc .sdiag { display: flex; gap: 8px; align-items: flex-end; height: 34px; margin-top: 22px; }
      .svc .sdiag b { width: 34px; border-radius: 3px 3px 0 0; background: linear-gradient(180deg, rgba(110,134,255,0.7) 0%, rgba(45,63,153,0.35) 100%); transform: scaleY(0.15); transform-origin: bottom; }

      /* S7 proof */
      #s7 { justify-content: center; }
      .s7-head { font-size: 66px; font-weight: 700; letter-spacing: -0.04em; margin: 14px 0 48px; }
      .stat-row { display: flex; gap: 24px; }
      .stat { flex: 1; padding: 32px 30px; border-radius: 20px; background: rgba(16,17,20,0.88); border: 1px solid rgba(255,255,255,0.10); }
      .stat .v { font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 66px; font-weight: 700; letter-spacing: -0.02em; color: #F6F7F8; }
      .stat .v .plus { color: #6E86FF; }
      .stat .k { font-size: 20px; font-weight: 500; color: #8A8E99; margin-top: 12px; letter-spacing: 0.02em; }
      .plogos { display: flex; gap: 22px; margin-top: 30px; }
      .plg { flex: 1; height: 92px; border-radius: 16px; background: rgba(16,17,20,0.88); border: 1px solid rgba(255,255,255,0.10); display: grid; place-items: center; }
      .plg img { height: 52px; width: auto; max-width: 86%; object-fit: contain; opacity: 0.9; }
      .qstage { position: relative; height: 120px; margin-top: 32px; }
      .quote { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; }
      .quote .qt { font-size: 33px; font-weight: 400; font-style: italic; color: #D9DBE1; letter-spacing: 0.01em; text-align: center; max-width: 1280px; }
      .quote .qt .qm { color: #4D6BFF; font-weight: 700; font-style: normal; }

      /* S8 manifesto */
      #s8 { align-items: center; text-align: center; }
      .mstage { position: relative; height: 300px; width: 100%; display: grid; place-items: center; }
      .mphrase { position: absolute; font-size: 118px; font-weight: 700; letter-spacing: -0.04em; line-height: 1.02; opacity: 0; max-width: 1620px; }
      .mphrase.small { font-size: 92px; }
      .s8-eye { margin-bottom: 44px; }

      /* S9 CTA */
      #s9 { align-items: center; text-align: center; }
      .bstage { position: relative; height: 440px; width: 100%; display: grid; place-items: center; }
      .bword { position: absolute; font-size: 176px; font-weight: 700; letter-spacing: -0.045em; opacity: 0; }
      .lockup { display: flex; flex-direction: column; align-items: center; opacity: 0; }
      .lockup img { width: 150px; filter: drop-shadow(0 18px 44px rgba(77,107,255,0.3)); }
      .lockup .ln { font-size: 66px; font-weight: 700; letter-spacing: -0.02em; margin-top: 28px; }
      .lockup .ls { font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 22px; letter-spacing: 0.42em; text-transform: uppercase; color: #8A8E99; margin-top: 16px; }
      .cta { margin-top: 44px; opacity: 0; }
      .cta .cl { font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 21px; letter-spacing: 0.3em; text-transform: uppercase; color: #6E86FF; }
      .cta .cc { display: flex; gap: 26px; justify-content: center; margin-top: 18px;
        font-family: "Geist Mono","IBM Plex Mono",monospace; font-size: 23px; color: #C9CCD4; }
      .cta .cc span { color: #565A66; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="115" data-width="1920" data-height="1080">

      <div id="bgfx">
        <div id="gridbg" data-layout-ignore></div>
        <div class="glow" id="glow-a" data-layout-ignore></div>
        <div class="glow" id="glow-b" data-layout-ignore></div>
        <div class="glow" id="glow-c" data-layout-ignore></div>
      </div>
      <canvas id="fx" width="1920" height="1080" data-layout-ignore></canvas>
      <svg class="grain-svg" id="grain" data-layout-ignore><filter id="gr"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#gr)"/></svg>
      <div id="vignette" data-layout-ignore></div>

      <!-- S1 hook (0-7.2) -->
      <div id="s1" class="scene">
        <div class="scene-inner">
          <div class="eyebrow s1-eye" id="s1-eye">3DM Solutions · The AI Product Studio</div>
          <div class="s1-head" id="s1a" data-layout-allow-overflow>
            <div class="mask"><span class="in">Most companies</span></div>
            <div class="mask"><span class="in">use AI as a tool.</span></div>
          </div>
          <div class="s1-head" id="s1b" data-layout-allow-overflow>
            <div class="mask"><span class="in">We build it</span></div>
            <div class="mask"><span class="in">as a <span class="blue sys-underline" id="sysword">system.<i class="ul" id="sysul"></i></span></span></div>
          </div>
        </div>
      </div>

      <!-- S2 brand reveal (7.2-17) -->
      <div id="s2" class="scene">
        <div class="scene-inner" style="display:flex;flex-direction:column;align-items:center;">
          <div class="logo-hero" id="logo-hero">
            <div class="lglow" id="lglow" data-layout-ignore></div>
            <img src="assets/logos/logo-white.png" alt="3DM" id="logo-img" />
            <div class="sheenwrap" data-layout-ignore><div class="sheen" id="logo-sheen"></div></div>
          </div>
          <div class="s2-wm" id="s2-wm">3DM</div>
          <div class="s2-label" id="s2-label">The AI Product Studio</div>
          <div class="s2-sub" id="s2-sub">From idea to launch</div>
          <div class="ribbon" id="ribbon">Products<span class="dot">·</span>Agents<span class="dot">·</span>Automation<span class="dot">·</span>Learning<span class="dot">·</span>Video<span class="dot">·</span>Growth</div>
        </div>
      </div>

      <!-- S3 origin (17-29.5) -->
      <div id="s3" class="scene">
        <div class="scene-inner">
          <div class="eyebrow" id="s3-eye">Origin</div>
          <div class="s3-head" id="s3-head" data-layout-allow-overflow>Three friends. Failed ideas.<br/><span class="blue">One obsession.</span></div>
          <div class="tl-wrap" id="tl-wrap">
            <div class="tl-line"><i id="tl-fill"></i></div>
            <div class="tl-node top t3" style="left:0px">
              <div class="tl-card"><div class="yr">2019</div><div class="tt">Three friends, one obsession</div><div class="td">Builders first. Products over promises.</div></div>
              <div class="nd"></div>
            </div>
            <div class="tl-node bot t3" style="left:590px">
              <div class="tl-card"><div class="yr">2020</div><div class="tt">Years of failed ideas</div><div class="td">Every miss sharpened the instinct.</div></div>
              <div class="nd"></div>
            </div>
            <div class="tl-node top t3" style="left:1180px">
              <div class="tl-card"><div class="yr">2023</div><div class="tt">A community is born</div><div class="td">An audience that wanted the tools we used.</div></div>
              <div class="nd"></div>
            </div>
          </div>
          <div class="tl-tags" id="tl-tags"><span>Learning</span><span>Iteration</span><span>Signal</span><span>Build</span></div>
        </div>
      </div>

      <!-- S4 build for ourselves (29.5-40.4) -->
      <div id="s4" class="scene">
        <div class="scene-inner">
          <div class="eyebrow" id="s4-eye">The method</div>
          <div class="s4-head" id="s4-head" data-layout-allow-overflow>Build for yourself. <span class="blue" id="validate-word">Validate fast.</span> Then scale.</div>
          <div class="flow" id="flow">
            <div class="fnode f4"><div class="fi">01</div><div class="ft">Problem</div></div>
            <div class="fcon f4c"><i></i></div>
            <div class="fnode f4"><div class="fi">02</div><div class="ft">Internal tool</div></div>
            <div class="fcon f4c"><i></i></div>
            <div class="fnode f4"><div class="fi">03</div><div class="ft">Launch</div></div>
            <div class="fcon f4c"><i></i></div>
            <div class="fnode f4"><div class="fi">04</div><div class="ft">Traction</div></div>
            <div class="fcon f4c"><i></i></div>
            <div class="fnode f4"><div class="fi">05</div><div class="ft">Partner demand</div></div>
          </div>
          <div class="pulses" id="pulses">
            <div class="pulse p4"><span class="pd"></span>Audience</div>
            <div class="pulse p4"><span class="pd"></span>Product</div>
            <div class="pulse p4"><span class="pd"></span>Traction</div>
            <div class="pulse p4"><span class="pd"></span>Demand</div>
          </div>
        </div>
      </div>

      <!-- S5 ecosystem with real app videos (40.4-60.4) -->
      <div id="s5" class="scene">
        <div class="scene-inner">
          <div class="eyebrow" id="s5-eye">The ecosystem</div>
          <div class="s5-head" id="s5-head" data-layout-allow-overflow>A product ecosystem, <span class="blue">not just services.</span></div>
          <div class="pstage" id="pstage">
            <div class="pcard" id="pc1">
              <div class="pmeta"><span class="ptag">Content</span><div class="pname">DialogueLab</div><div class="pdesc">All-in-one AI platform for creating, structuring, and scaling short-form content.</div></div>
              <div class="pvid"><video id="av1" class="clip" data-start="42.2" data-duration="4.4" data-track-index="0" src="assets/videos/apps/dialoguelab.mp4" muted playsinline></video></div>
            </div>
            <div class="pcard" id="pc2">
              <div class="pmeta"><span class="ptag">Video</span><div class="pname">InfluenceGen</div><div class="pdesc">AI video platform generating complete content from a single image and script.</div></div>
              <div class="pvid"><video id="av2" class="clip" data-start="45.5" data-duration="4.4" data-track-index="1" src="assets/videos/apps/influencegen.mp4" muted playsinline></video></div>
            </div>
            <div class="pcard" id="pc3">
              <div class="pmeta"><span class="ptag">Learning</span><div class="pname">DevQuest</div><div class="pdesc">AI learning platform turning any topic into structured, interactive courses.</div></div>
              <div class="pvid"><video id="av3" class="clip" data-start="48.8" data-duration="4.4" data-track-index="2" src="assets/videos/apps/devquest.mp4" muted playsinline></video></div>
            </div>
            <div class="pcard" id="pc4">
              <div class="pmeta"><span class="ptag">Microlearning</span><div class="pname">EduGen</div><div class="pdesc">AI microlearning engine converting documents into short, visual learning content.</div></div>
              <div class="pvid"><video id="av4" class="clip" data-start="52.1" data-duration="4.4" data-track-index="3" src="assets/videos/apps/edugen.mp4" muted playsinline></video></div>
            </div>
            <div class="pcard" id="pc5">
