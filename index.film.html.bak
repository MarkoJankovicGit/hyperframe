      <!-- risers + counters + beeps -->
      <audio id="rs1" class="clip" data-start="3.9"  data-duration="1.2" data-track-index="26" data-volume="0.3"  src="sound-effects/sci-fi-weapon-projectile-flyby-plasma-03-233857.mp3"></audio>
      <audio id="rs2" class="clip" data-start="98.2" data-duration="1.2" data-track-index="26" data-volume="0.3"  src="sound-effects/sci-fi-weapon-projectile-flyby-plasma-03-233857.mp3"></audio>
      <audio id="cnt" class="clip" data-start="74.8" data-duration="1.2" data-track-index="27" data-volume="0.32" src="sound-effects/Digital Counting Sound Effect.mp3"></audio>
      <audio id="bp1" class="clip" data-start="31.0" data-duration="0.8" data-track-index="28" data-volume="0.2"  src="sound-effects/digital-beeping-151921.mp3"></audio>
      <!-- manifesto word hits -->
      <audio id="mh1" class="clip" data-start="88.6"  data-duration="0.5" data-track-index="29" data-volume="0.22" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
      <audio id="mh2" class="clip" data-start="90.2"  data-duration="0.5" data-track-index="29" data-volume="0.22" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
      <audio id="mh3" class="clip" data-start="91.9"  data-duration="0.5" data-track-index="29" data-volume="0.22" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
      <audio id="mh4" class="clip" data-start="94.14" data-duration="0.5" data-track-index="29" data-volume="0.22" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
      <audio id="mh5" class="clip" data-start="95.85" data-duration="0.5" data-track-index="29" data-volume="0.22" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
      <!-- B/A/S word hits -->
      <audio id="bh1" class="clip" data-start="99.8"  data-duration="0.5" data-track-index="30" data-volume="0.26" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
      <audio id="bh2" class="clip" data-start="101.3" data-duration="0.5" data-track-index="30" data-volume="0.26" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
      <audio id="bh3" class="clip" data-start="102.8" data-duration="0.5" data-track-index="30" data-volume="0.26" src="sound-effects/flash-whoosh-swoosh-7-SBA-300462861.mp3"></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      gsap.registerPlugin(CustomEase, SplitText, ScrambleTextPlugin);
      CustomEase.create("cine", "M0,0 C0.16,0 0.1,1 1,1");
      const tl = gsap.timeline({ paused: true });
      const DUR = 115;

      /* ---------- deterministic particle field ---------- */
      const cv = document.getElementById("fx"), ctx = cv.getContext("2d");
      function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
      const rnd = mulberry32(20240703);
      const N = 150, P = [];
      for (let i=0;i<N;i++) P.push({ x: rnd()*1920, y: rnd()*1080, z: rnd(), sp: 0.15+rnd()*0.7, ph: rnd()*6.283, dx: (rnd()-0.5) });
      const BURSTS = [[7.1,960,540],[40.3,960,540],[87.3,960,540],[98.8,960,420]];
      function drawFX(t){
        ctx.clearRect(0,0,1920,1080);
        for (const p of P){
          let y = (p.y - t*p.sp*16) % 1080; if (y<0) y += 1080;
          const x = p.x + Math.sin(t*0.25 + p.ph)*26*p.dx;
          const a = (0.08 + 0.42*p.z) * (0.55 + 0.45*Math.sin(t*0.5 + p.ph));
          const r = 0.5 + p.z*1.7;
          ctx.beginPath(); ctx.arc(x, y, r, 0, 6.283);
          ctx.fillStyle = "rgba(150,175,255," + a.toFixed(3) + ")"; ctx.fill();
        }
        for (const b of BURSTS){
          const dt = t - b[0];
          if (dt > 0 && dt < 1.6){
            const pr = dt/1.6, rad = 60 + pr*780, al = 0.22*(1-pr);
            ctx.beginPath(); ctx.arc(b[1], b[2], rad, 0, 6.283);
            ctx.strokeStyle = "rgba(120,148,255," + al.toFixed(3) + ")"; ctx.lineWidth = 1.5; ctx.stroke();
          }
        }
      }
      drawFX(0);
      const clock = { t: 0 };
      tl.to(clock, { t: DUR, duration: DUR, ease: "none", onUpdate: () => drawFX(clock.t) }, 0);

      /* ambient */
      tl.to("#glow-a", { x: 90, y: 60, scale: 1.12, duration: 57, ease: "sine.inOut", yoyo: true, repeat: 1 }, 0);
      tl.to("#glow-b", { x: -80, y: -50, scale: 1.14, duration: 52, ease: "sine.inOut", yoyo: true, repeat: 1 }, 0);
      tl.to("#glow-c", { opacity: 0.6, scale: 1.2, duration: 8, ease: "sine.inOut", yoyo: true, repeat: 13 }, 0);
      tl.to("#grain rect", { attr: { x: 8 }, duration: 0.25, ease: "none", repeat: 459, yoyo: true }, 0);
      tl.to("#gridbg", { opacity: 1, duration: 1.2, ease: "power1.inOut" }, 17.0);
      tl.to("#gridbg", { opacity: 0, duration: 1.2, ease: "power1.inOut" }, 40.4);
      tl.to("#gridbg", { opacity: 0.7, duration: 1.2, ease: "power1.inOut" }, 60.4);
      tl.to("#gridbg", { opacity: 0, duration: 1.2, ease: "power1.inOut" }, 73.4);

      function go(prev, next, ws) {
        const s = ws - 0.2;
        tl.to(prev, { opacity: 0, scale: 1.04, duration: 0.55, ease: "power2.inOut" }, s);
        tl.set(next, { opacity: 1 }, s + 0.15);
        tl.fromTo(next, { scale: 1.035 }, { scale: 1, duration: 1.0, ease: "cine" }, s + 0.15);
      }
      function countUp(sel, to, t, dur) {
        const o = { v: 0 };
        tl.to(o, { v: to, duration: dur, ease: "power2.out", onUpdate() { const e = document.querySelector(sel); if (e) e.textContent = Math.round(o.v); } }, t);
      }

      /* ---------- captions ---------- */
      const CAPS = [
        [0.9, 3.5, "Most companies use AI as a tool."],
        [3.66, 6.6, "We build it as a system."],
        [8.1, 11.0, "3DM is an AI product studio."],
        [11.2, 16.8, "From idea to launch, we build, scale, and ship AI products."],
        [17.9, 24.8, "3DM started with three friends, a long list of failed ideas, and one obsession."],
        [25.04, 28.6, "Building things that actually work."],
        [30.4, 33.2, "We built AI tools for ourselves first."],
        [33.35, 36.2, "Shipped them. Our audience responded."],
        [36.33, 40.1, "Then partners started asking for the same systems."],
        [41.3, 49.4, "Today, 3DM spans content systems, video generation, learning platforms, and optimization engines."],
        [49.66, 52.9, "Each one born from real use."],
        [61.3, 64.5, "We help companies build AI-powered products,"],
        [64.64, 67.8, "automate content, create learning systems,"],
        [67.99, 72.0, "and deploy agents that run real workflows."],
        [74.3, 76.3, "This is not theory."],
        [76.45, 80.9, "We've built products, grown communities, and earned trust"],
        [81.1, 85.4, "from brands and partners who care about moving fast."],
        [88.3, 91.5, "Behind every system is the same mindset."],
        [91.69, 97.6, "Move early, solve sharply, validate in the market, and own the stack."],
        [99.5, 103.9, "3DM builds the systems ambitious companies use to launch faster,"],
        [104.07, 108.0, "scale smarter, and turn AI into real advantage."],
        [108.21, 112.2, "If you're building something meaningful, let's talk."]
      ];
      const capEl = document.getElementById("capline");
      CAPS.forEach(c => {
        tl.call(() => { capEl.textContent = c[2]; }, null, c[0] - 0.01);
        tl.fromTo("#capline", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.28, ease: "power2.out" }, c[0]);
        tl.to("#capline", { opacity: 0, duration: 0.22, ease: "power1.in" }, c[1]);
      });

      /* ===== S1 hook (0-7.2) ===== */
      tl.from("#s1-eye", { opacity: 0, y: 12, duration: 0.7, ease: "power2.out" }, 0.4);
      tl.fromTo("#s1 .scene-inner", { scale: 1.0 }, { scale: 1.05, duration: 7.2, ease: "none" }, 0);
      tl.from("#s1a .in", { y: 78, opacity: 0, filter: "blur(10px)", duration: 0.95, stagger: 0.1, ease: "cine" }, 0.8);
      tl.from("#s1b .in", { y: 95, opacity: 0, filter: "blur(12px)", duration: 1.05, stagger: 0.12, ease: "cine" }, 3.5);
      tl.to("#sysul", { scaleX: 1, duration: 0.6, ease: "expo.out" }, 4.75);

      /* ===== S2 brand (7.2-17) ===== */
      go("#s1", "#s2", 7.2);
      tl.fromTo("#logo-img", { scale: 0.6, opacity: 0, filter: "blur(14px)" }, { scale: 1, opacity: 1, filter: "blur(0px)", duration: 1.1, ease: "cine" }, 7.5);
      tl.fromTo("#lglow", { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.2, ease: "power2.out" }, 7.5);
      tl.to("#lglow", { scale: 1.14, duration: 2.6, ease: "sine.inOut", yoyo: true, repeat: 1 }, 8.8);
      tl.fromTo("#logo-sheen", { x: -140 }, { x: 300, duration: 1.1, ease: "power2.inOut" }, 8.4);
      tl.from("#s2-wm", { y: 46, opacity: 0, duration: 0.8, ease: "cine" }, 8.7);
      tl.from("#s2-label", { y: 22, opacity: 0, duration: 0.7, ease: "power2.out" }, 9.1);
      tl.from("#s2-sub", { y: 20, opacity: 0, duration: 0.7, ease: "power2.out" }, 11.2);
      tl.from("#ribbon", { opacity: 0, y: 18, duration: 0.8, ease: "power2.out" }, 12.0);
      tl.fromTo("#ribbon", { x: 40 }, { x: -40, duration: 4.6, ease: "sine.inOut" }, 12.2);
      tl.fromTo("#logo-hero", { rotate: -2 }, { rotate: 2, duration: 9.4, ease: "sine.inOut" }, 7.6);

      /* ===== S3 origin (17-29.5) ===== */
      go("#s2", "#s3", 17.0);
      tl.fromTo("#s3 .scene-inner", { x: 40, scale: 1.0 }, { x: -40, scale: 1.04, duration: 12.5, ease: "none" }, 17.0);
      tl.from("#s3-eye", { opacity: 0, y: 12, duration: 0.6, ease: "power2.out" }, 17.4);
      tl.from("#s3-head", { y: 50, opacity: 0, filter: "blur(8px)", duration: 0.9, ease: "cine" }, 17.6);
      tl.to("#tl-fill", { scaleX: 1, duration: 6.0, ease: "power1.inOut" }, 18.6);
      tl.from(".t3", { y: 44, opacity: 0, filter: "blur(6px)", duration: 0.75, stagger: 2.1, ease: "cine" }, 19.7);
      tl.from("#tl-tags span", { opacity: 0, y: 14, duration: 0.5, stagger: 0.12, ease: "power2.out" }, 26.0);

      /* ===== S4 method (29.5-40.4) ===== */
      go("#s3", "#s4", 29.5);
      tl.fromTo("#s4 .scene-inner", { scale: 1.0 }, { scale: 1.045, duration: 10.9, ease: "none" }, 29.5);
      tl.from("#s4-eye", { opacity: 0, y: 12, duration: 0.6, ease: "power2.out" }, 29.8);
      tl.from("#s4-head", { y: 46, opacity: 0, filter: "blur(8px)", duration: 0.9, ease: "cine" }, 30.0);
      tl.to("#validate-word", { duration: 0.9, scrambleText: { text: "Validate fast.", chars: "01<>/#", speed: 0.4 } }, 33.9);
      tl.from(".f4", { y: 40, opacity: 0, duration: 0.6, stagger: 0.55, ease: "cine" }, 30.9);
      tl.to(".f4c i", { scaleX: 1, duration: 0.45, stagger: 0.55, ease: "power2.inOut" }, 31.4);
      tl.from(".p4", { y: 26, opacity: 0, duration: 0.55, stagger: 0.14, ease: "power2.out" }, 35.1);
      tl.to(".p4 .pd", { opacity: 0.35, duration: 0.5, stagger: 0.1, yoyo: true, repeat: 5, ease: "sine.inOut" }, 36.1);

      /* ===== S5 ecosystem with app videos (40.4-60.4) ===== */
      go("#s4", "#s5", 40.4);
      tl.fromTo("#s5 .scene-inner", { scale: 1.0 }, { scale: 1.03, duration: 20, ease: "none" }, 40.4);
      tl.from("#s5-eye", { opacity: 0, y: 12, duration: 0.6, ease: "power2.out" }, 40.7);
      tl.from("#s5-head", { y: 46, opacity: 0, filter: "blur(8px)", duration: 0.9, ease: "cine" }, 40.9);
      tl.from("#pstage", { y: 54, opacity: 0, duration: 0.8, ease: "cine" }, 41.4);
      tl.from(".ptab", { y: 20, opacity: 0, duration: 0.5, stagger: 0.08, ease: "power2.out" }, 41.6);
      const heroT = [43.1, 46.4, 49.7, 53.0, 56.3];
      for (let i = 0; i < 5; i++) {
        const t = heroT[i], id = "#pc" + (i + 1), tab = "#pt" + (i + 1);
        tl.fromTo(id, { opacity: 0, y: 30, scale: 0.985, filter: "blur(6px)" }, { opacity: 1, y: 0, scale: 1, filter: "blur(0px)", duration: 0.55, ease: "cine" }, t);
        if (i > 0) tl.to("#pc" + i, { opacity: 0, y: -26, scale: 1.015, filter: "blur(5px)", duration: 0.45, ease: "power2.in" }, t - 0.05);
        tl.to(tab, { className: "ptab on", duration: 0.01 }, t);
        if (i > 0) tl.to("#pt" + i, { className: "ptab", duration: 0.01 }, t);
      }
      tl.to("#pc5", { y: -6, duration: 3.2, ease: "sine.inOut" }, 57.0);

      /* ===== S6 services (60.4-73.4) ===== */
      go("#s5", "#s6", 60.4);
      tl.fromTo("#s6 .scene-inner", { scale: 1.0 }, { scale: 1.045, duration: 13, ease: "none" }, 60.4);
      tl.from("#s6-eye", { opacity: 0, y: 12, duration: 0.6, ease: "power2.out" }, 60.7);
      tl.from("#s6-head", { y: 46, opacity: 0, filter: "blur(8px)", duration: 0.9, ease: "cine" }, 60.9);
      tl.from(".v6", { y: 46, opacity: 0, filter: "blur(6px)", duration: 0.7, stagger: 0.16, ease: "cine" }, 61.6);
      const svT = [63.6, 64.7, 66.2, 68.3];
      for (let i = 0; i < 4; i++) {
        const id = "#sv" + (i + 1), t = svT[i];
        tl.to(id, { borderColor: "rgba(110,134,255,0.55)", y: -8, duration: 0.5, ease: "power2.out" }, t);
        tl.to(id + " .sdiag b", { scaleY: 1, duration: 0.5, stagger: 0.06, ease: "power2.out" }, t + 0.1);
        if (i > 0) tl.to("#sv" + i, { borderColor: "rgba(255,255,255,0.10)", y: 0, duration: 0.5, ease: "power2.inOut" }, t);
      }
      tl.to("#sv4 .sdiag b", { scaleY: 0.5, duration: 1.4, stagger: 0.08, yoyo: true, repeat: 1, ease: "sine.inOut" }, 70.2);

      /* ===== S7 proof (73.4-87.4) ===== */
      go("#s6", "#s7", 73.4);
      tl.fromTo("#s7 .scene-inner", { scale: 1.0 }, { scale: 1.045, duration: 14, ease: "none" }, 73.4);
      tl.from("#s7-eye", { opacity: 0, y: 12, duration: 0.6, ease: "power2.out" }, 73.7);
      tl.from("#s7-head", { y: 46, opacity: 0, filter: "blur(8px)", duration: 0.9, ease: "cine" }, 73.9);
      tl.from(".s7s", { y: 40, opacity: 0, duration: 0.6, stagger: 0.12, ease: "cine" }, 74.7);
      countUp("#n1", 350, 74.9, 1.4);
      countUp("#n2", 5, 75.1, 1.0);
      countUp("#n3", 200, 75.3, 1.3);
      countUp("#n4", 5, 75.5, 1.0);
      tl.from(".l7", { y: 34, opacity: 0, duration: 0.55, stagger: 0.11, ease: "cine" }, 79.6);
      const qT = [82.6, 84.3, 86.0];
      for (let i = 0; i < 3; i++) {
        const id = "#q" + (i + 1), t = qT[i];
        tl.fromTo(id, { opacity: 0, y: 22, filter: "blur(5px)" }, { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.5, ease: "cine" }, t);
        if (i > 0) tl.to("#q" + i, { opacity: 0, y: -18, duration: 0.4, ease: "power2.in" }, t - 0.05);
      }

      /* ===== S8 manifesto (87.4-98.6) ===== */
      go("#s7", "#s8", 87.4);
      tl.fromTo("#s8 .scene-inner", { scale: 1.0 }, { scale: 1.05, duration: 11.2, ease: "none" }, 87.4);
      tl.from("#s8-eye", { opacity: 0, y: 12, duration: 0.6, ease: "power2.out" }, 87.7);
      const mT = [88.6, 90.2, 91.9, 94.14, 95.85];
      for (let i = 0; i < 5; i++) {
        const id = "#m" + (i + 1), t = mT[i];
        tl.fromTo(id, { opacity: 0, y: 44, scale: 0.96, filter: "blur(10px)" }, { opacity: 1, y: 0, scale: 1, filter: "blur(0px)", duration: 0.55, ease: "cine" }, t);
        if (i > 0) tl.to("#m" + i, { opacity: 0, y: -36, scale: 1.04, filter: "blur(8px)", duration: 0.45, ease: "power2.in" }, t - 0.03);
      }
      tl.to("#m5 .blue", { duration: 0.9, scrambleText: { text: "your stack.", chars: "01<>/#", speed: 0.4 } }, 96.0);

      /* ===== S9 CTA (98.6-115) ===== */
      go("#s8", "#s9", 98.6);
      tl.fromTo("#s9 .scene-inner", { scale: 1.0 }, { scale: 1.03, duration: 16.4, ease: "none" }, 98.6);
      const bT = [99.8, 101.3, 102.8];
      for (let i = 0; i < 3; i++) {
        const id = "#b" + (i + 1), t = bT[i];
        tl.fromTo(id, { opacity: 0, y: 54, scale: 0.94, filter: "blur(12px)" }, { opacity: 1, y: 0, scale: 1, filter: "blur(0px)", duration: 0.5, ease: "cine" }, t);
        tl.to(id, { opacity: 0, y: -44, scale: 1.05, filter: "blur(9px)", duration: 0.42, ease: "power2.in" }, t + 1.08);
      }
      tl.fromTo("#lockup", { opacity: 0, y: 34, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: "cine" }, 104.6);
      tl.fromTo("#cta", { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 108.4);
      tl.to("#s9 .scene-inner", { opacity: 0, duration: 0.8, ease: "power2.in" }, 114.0);
      tl.to("#capbar", { opacity: 0, duration: 0.5 }, 113.4);

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
